{
  "name": "cheap-mem",
  "version": "0.1.0",
  "description": "Cheap in tokens, rich in memory. A local-first, git-backed persistent memory layer for AI coding assistants.",
  "type": "module",
  "bin": {
    "mem": "./bin/mem",
    "mem-mcp": "./bin/mem-mcp",
    "cheap-mem": "./bin/mem"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bench/tokens.mjs && node bench/retrieval.mjs",
    "verify": "node bench/mutation.mjs && node bench/fuzz.mjs && node bench/composed.mjs && node bench/byzantine.mjs && node bench/cache-attack.mjs && node bench/query-independence.mjs && node bench/merge-driver.mjs",
    "lint": "eslint bin src test bench",
    "coverage": "c8 --reporter=text-summary --reporter=lcov node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Luckyno777/cheap-mem"
  },
  "keywords": [
    "ai",
    "memory",
    "claude",
    "chatgpt",
    "cursor",
    "gemini",
    "mcp",
    "cli"
  ],
  "files": [
    "bin/",
    "src/",
    "install/",
    "HOUSE-RULES.md",
    "hooks/",
    "docs/",
    "DIGEST.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "sqlite-vec": "^0.1.6"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^10.1.3",
    "eslint": "^9.39.5"
  }
}
