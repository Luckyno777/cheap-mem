/** The package root — where `assets/` lives, whatever the memory root is. */
const PACKAGE_ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');

export function readConfig(env = process.env) {
  return {
    token: env.CHEAP_MEM_SERVE_TOKEN || '',
    host: env.CHEAP_MEM_SERVE_HOST || '127.0.0.1',
    port: Number(env.CHEAP_MEM_SERVE_PORT || 8847),
    title: env.CHEAP_MEM_SERVE_TITLE || 'cheap-mem',
    // The PWA worker stores nothing unless this is 1 — see src/pwa.mjs.
    offline: env.CHEAP_MEM_SERVE_OFFLINE === '1',
    // **Writing is OFF by default** (decision 2026-09-27, reversing the
    // earlier "on by default"): an open-source dashboard writes nothing
    // before its owner allows it. The switch is `dashboard.allowWrites`
    // in `.mem/config.json`, or `allowWrites` below for one run
    // (`mem serve --allow-writes`); see `src/writegate.mjs`. READONLY is
    // the older, stricter latch and still wins over both.
    readonly: env.CHEAP_MEM_SERVE_READONLY === '1',
    allowWrites: false,
    hosts: String(env.CHEAP_MEM_SERVE_HOSTS ?? '')
      .split(',').map((x) => x.trim()).filter(Boolean),
    origins: String(env.CHEAP_MEM_SERVE_ORIGINS ?? '')
      .split(',').map((x) => x.trim()).filter(Boolean),
    // The password in front of the dashboard (src/login.mjs). ON by
    // default; only CHEAP_MEM_SERVE_LOGIN=off (tests, local use) turns it off.
    login: login.enabled(env),
  };
}

export function bindAllowed({ host, token }) {
  return webauth.bindAllowed({ host, token, variable: 'CHEAP_MEM_SERVE_TOKEN' });
}

/** Token from query, cookie or bearer — in that order. */
function tokenFrom(req, url) {
  const q = url.searchParams.get('k');
  if (q) return q;
  const bearer = webauth.bearerFrom(req);
  if (bearer) return bearer;
  const cookie = req.headers.cookie || '';
  const m = /(?:^|;\s*)mem_k=([^;]+)/.exec(cookie);
  if (!m) return '';
  try { return decodeURIComponent(m[1]); } catch { return ''; } // broken %-sequence: fail closed
}

/**
 * Every path this server answers. A list, not a rule, so a new path is a
 * decision that shows up in a diff.
 *
 * **Exported deliberately.** The auth probe in `test/console.test.mjs`
 * used to carry its own hand-typed copy of three of these, and when
 * `/pult` and `/dashboard.json` were added on 2026-09-16 the probe went
 * on passing while saying nothing about them — a guarantee that covers
 * a list nobody keeps in step is the defect this project keeps meeting.
 * The probe now reads THIS list, so a sixth path is covered the moment
 * it is added.
 */
/** N9 parity: where a Today-card fact verdict is POSTed. */
export const VERIFY_VERDICT_PATH = '/dashboard/verify-verdict';
/** N9 parity ("gold nebenbei"/"Rate today"): where a verdict on a REAL
 *  retrieval question (src/goldlog.mjs) is POSTed. Separate from
 *  VERIFY_VERDICT_PATH — a different judgement on a different source,
 *  see src/goldlog.mjs's header. */
export const GOLD_VERDICT_PATH = '/dashboard/gold-verdict';

export const PATHS = Object.freeze([
  '/', '/console', '/viewer', '/setting', '/console.json', '/desk.json',
  // Redirect aliases for bookmarks from before 2026-10-01 (English paths).
  '/pult', '/pult.json',
  '/entry.json', '/entries.json', entriesPage.PATH, '/task', '/task.json', '/task/cancel', '/inbox/reply',
  // The dashboard (2026-09-28): the page, its data, one entry, one
  // message, the retrieval probe, the bitemporal facts, its three files,
  // the service-worker registration, the two fonts, and the PWA shell.
  // All of them READ; writing stays on the routes in WRITE_PATHS.
  ...Object.values(dashboardPage.PATHS),
  ...dashboardPage.FONTS.map((f) => f.path),
  '/manifest.webmanifest', '/sw.js', '/favicon.ico',
  '/inbox/state',
  // Full-text search of the knowledge view (src/fulltext.mjs): READ only.
  fulltext.PATH,
  // N9 parity (2026-09-28): a human's verdict on an uncertain fact
  // from the Today card — appends OUTSIDE the memory, see
  // src/verifylog.mjs and the route below.
  VERIFY_VERDICT_PATH,
  GOLD_VERDICT_PATH,
  // The password in front of the dashboard (src/login.mjs), behind the
  // token door like everything else; 404 under CHEAP_MEM_SERVE_LOGIN=off.
  ...login.ALL_PATHS,
]);

/**
 * The paths that WRITE. Every one of them runs `writegate.refusal()`
 * first; the probes read this list, so a sixth writing route is
 * covered the moment it is named here.
 */
export const WRITE_PATHS = Object.freeze(['/setting', '/task', '/task/cancel', '/inbox/reply', '/inbox/state', VERIFY_VERDICT_PATH, GOLD_VERDICT_PATH]);

/**
 * The routes that hand out memory content as JSON to a script. Each one
 * checks the Host header first (`hostOk`) — never a CORS header.
 */
export const HOST_GUARDED = Object.freeze([
  dashboardPage.PATHS.data, dashboardPage.PATHS.entry, dashboardPage.PATHS.message,
  dashboardPage.PATHS.probe, dashboardPage.PATHS.factsAt, dashboardPage.PATHS.part, fulltext.PATH,
  // The project package export (src/projectpackage.mjs): memory content too.
  dashboardPage.PATHS.projectPackage,
  // The skill catalogue (src/skillcatalog.mjs): entry texts and history.
  dashboardPage.PATHS.skills,
  // The calendar: appointment titles and states.
  dashboardPage.PATHS.appointments,
  // D3b: the list as a page, and its JSON twin, read the same memory.
  entriesPage.PATH, '/entries.json',
]);

/**
 * The Host check against DNS rebinding, for every route that returns
 * memory content to a script (the sibling's `hostPasstZurBindung`).
 *
 * An Origin check compares Origin AGAINST Host and needs an Origin; a
 * plain GET from the page's own script often carries none, which is the
 * normal case for a read, not a suspicion. What a rebinding attacker
 * cannot forge is the NAME we agree to be reachable under — the Host
 * header the browser takes from the URL. Loopback is ours; any other
 * name must be listed in CHEAP_MEM_SERVE_HOSTS (or be the host of an
 * origin in CHEAP_MEM_SERVE_ORIGINS — the list the write gate already
 * uses behind a tunnel). And never a CORS header: no foreign page may
 * read these answers, not even with a valid cookie.
 */
export function hostOk(host, cfg) {
  const fromOrigins = (cfg.origins ?? []).map((o) => { try { return new URL(o).host; } catch { return null; } })
    .filter(Boolean);
  return webauth.hostAllowed(host, [...(cfg.hosts ?? []), ...fromOrigins]);
}

/**
 * The content security policy of the dashboard page. Everything from
 * this server, nothing inline that runs: scripts are files
 * (`script-src 'self'`), the one inline block is the font-face CSS.
 */
export const CSP = [
  "default-src 'self'", "script-src 'self'", "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:", "font-src 'self'", "connect-src 'self'", "manifest-src 'self'",
  "worker-src 'self'", "frame-ancestors 'none'", "base-uri 'none'", "form-action 'self'",
].join('; ');

/** The server config, as `writegate.read()` takes it. */
export function gateOpts(cfg) {
  return { flag: cfg.allowWrites === true, readonly: cfg.readonly === true };
}

/** The headers every content response carries. Once, not three times. */
const HEAD = Object.freeze({
  'cache-control': 'no-store',
  // The content is private: no referrer, no framing, no sniffing.
  'referrer-policy': 'no-referrer',
  'x-content-type-options': 'nosniff',
  'x-frame-options': 'DENY',
});

function short(res, code, text) {
  res.writeHead(code, { ...HEAD, 'content-type': 'text/html; charset=utf-8' })
    .end(`<!doctype html><meta charset="utf-8"><title>console</title>`
      + `<body style="font:16px/1.5 system-ui;padding:1rem">`
      + `<p><b>Not set.</b></p><p>${String(text).replace(/[<&]/g, '')}</p>`
      + `<p><a href="/">back to the console</a></p>`);
}

/**
 * **The deferred parts of /dashboard.json (tempo, 2026-09-28).** Per part:
 * where the list sits in the full result of `collectDashboard()`. The
 * overview does not show them; /dashboard.json carries only
 * `parts.<name> = { path, count }` instead of the list, and the tab fetches
 * it through `/dashboard/part.json?part=<name>` — from the SAME cached
 * build (one truth, delivered twice).
 */
export const DEFERRED_PARTS = Object.freeze({
  raw: { section: 'raw', field: 'captures', readable: (d) => d.raw?.readable === true },
  inbox: { section: 'inbox', field: 'messages', readable: (d) => d.inbox?.readable === true },
  // board-tempo-cm: `section: null` = a top-level list. The learnings with
  // their citation counts grow with the store (2.8 MB at 100k entries).
  experiences: { section: null, field: 'experiences', readable: () => true },
});
/** The list of a deferred part in a full result. */
const partList = (data, p) => (p.section ? data[p.section]?.[p.field] : data[p.field]);

/**
 * @param env the environment `cfg` was BUILT from — not `process.env`.
 * The sibling project shipped that mistake: the page then reports
 * connections belonging to a different server than the one serving it.
 */
export function buildHandler(root, cfg, env = process.env) {
  // Login (src/login.mjs): ONE context per handler — the limiter counts
  // failures in this process's memory. A `cfg` without a `login` field
  // (built by hand) counts as ON: the default is the lock, not the open door.
  const loginOn = cfg.login !== false;
  const loginCtx = {
    root,
    dir: login.dirFor(root, env),
    token: cfg.token,
    pagePaths: [dashboardPage.PATHS.page, '/', '/pult', '/console', '/viewer'],
    hostOk: (host) => hostOk(host, cfg),
    originOk: (req) => webauth.postOriginOk(req.headers.origin, req.headers.host, cfg.origins),
    head: HEAD,
    csp: CSP,
    limiter: login.newLimiter(),
    page: { fontCss: dashboardPage.fontCss(), mark: icon.markSvg() },
    log: (line) => process.stderr.write(line + '\n'),
    equal: webauth.constantEqual,
  };
  const loginFree = ['/favicon.ico', '/sw.js', ...dashboardPage.FONTS.map((f) => f.path)];
  // **Y4b: did a signed-in PERSON trigger this action?** Only a valid
  // PASSWORD session (cookie, src/login.mjs) shows that: only the owner
  // knows the password. NOT counted as proof:
  //   - the bearer token (CHEAP_MEM_SERVE_TOKEN) — tools, probes and
  //     anyone handed the link carry it;
  //   - a server with CHEAP_MEM_SERVE_LOGIN=off — there is no sign-in;
  //   - the MCP bridge — it does not write through this server.
  // Only then does `tasks.start` hand `--authority user` to the command.
  const personSignedIn = (req) => {
    if (!loginOn) return false;
    try { return login.checkSession(loginCtx.dir, login.cookieFrom(req)).valid === true; } catch { return false; }
  };
  // --- tempo: /dashboard.json from the cache --------------------------------
  // ONE cache per handler (not per module): a probe that builds its own
  // handler never sees another one's result.
  const writesAllowed = () => writegate.read(root, gateOpts(cfg)).allowed;
  // The skill effect reads the raw capture: measured at most once a minute.
  let effectCache = { at: 0, value: null };
  const skillEffect = () => {
    if (effectCache.value && Date.now() - effectCache.at < 60000) return effectCache.value;
    let v;
    try { v = skilleffect.measure(root); } catch (e) { v = { state: 'unknown', reason: e?.message || String(e), skills: [] }; }
    effectCache = { at: Date.now(), value: v };
    return v;
  };
  const dashOptions = (w) => ({ env, cfg, title: cfg.title, writesAllowed: w });
  // no-jump: TEST ONLY — with a tiny test store the cache always builds
  // synchronously and is therefore immediately fresh on every answer
  // (see the "small store" positive control in
  // test/tempo-dashboard-cache.test.mjs); a probe needs real "not fresh"
  // answers to trigger the quiet refetch at all. Set forces the
  // background path (syncUpToMs=0) and sets the minimum gap between two
  // background builds to CHEAP_MEM_SERVE_CACHE_GAP_TEST_MS (default 0;
  // otherwise 20 s; cat-confirm-cm needs a long one). Without this variable (normal
  // operation) unchanged.
  const syncUpToMsTest = env.CHEAP_MEM_SERVE_CACHE_SYNC_TEST_MS;
  // board-tempo-cm: the route of the paged `entries` part, and the light
  // head (only counters and the newest entries) for a store the full build
  // cannot handle — with its reason.
  const entriesRoute = `${dashboardPage.PATHS.part}?part=entries`;
  let fullFailed = null; // { bytes, reason } — see buildInBackground
  // Above this size of the drawers only the light head is built. The
  // default is measured (src/dashboard-head.mjs); the variable tunes it
  // (MB) — for a bigger machine, and for the probes.
  // How many of the newest entries the first answer carries (default 120).
  const headMaxEnv = Number(env.CHEAP_MEM_SERVE_HEAD_ENTRIES);
  const headMax = Number.isFinite(headMaxEnv) && headMaxEnv >= 1 ? Math.floor(headMaxEnv) : dashboardHead.HEAD_ENTRIES;
  const fullBuildMb = Number(env.CHEAP_MEM_SERVE_FULL_BUILD_MB);
  const fullBuildMax = Number.isFinite(fullBuildMb) && fullBuildMb > 0 ? fullBuildMb * 1048576 : dashboardHead.FULL_BUILD_UP_TO_BYTES;
  const lightBuild = (reason) => dashboardCache.buildInWorker(root, {
    kind: 'head', title: cfg.title, writesAllowed: writesAllowed(), reason, types: dashboardData.typesList(), route: entriesRoute,
  });
  // atlas-pass-cm: above the line (or when the full build fails at its heap cap)
  // the server builds COMPACT: one pass over the drawers, bounded memory, the
  // condensed 3D atlas (src/dashboard-compact.mjs). The topics of the last atlas
  // get their sample from the first line on.
  // How many of the newest entries the compact build lists (default 30,000; the variable is for the probes).
  const windowEnv = Number(env.CHEAP_MEM_SERVE_WINDOW_ENTRIES);
  const compactWindow = Number.isFinite(windowEnv) && windowEnv >= 1 ? Math.floor(windowEnv) : dashboardPass.WINDOW;
  let lastThemes = [];
  let modulesFailed = null; // the size at which the modules that read the whole store hit the heap cap
  const compactBuild = async (bytes, why = null) => {
    const run = (extra) => dashboardCache.buildInWorker(root, {
      ...dashOptions(writesAllowed()), kind: 'compact', env: { ...env }, bytes, themeHints: lastThemes, window: compactWindow, ...extra,
    });
    let data;
    if (modulesFailed !== null && bytes !== null && bytes >= modulesFailed) {
      data = await run({ modulesUpTo: 0, ...(why ? { why } : {}) });
    } else {
      try {
        data = await run(why ? { why } : {});
      } catch (e) {
        // The modules that read the whole store on their own took the worker over
        // its memory cap: once more without them, and not again at this size.
        if (bytes !== null) modulesFailed = bytes;
        data = await run({ modulesUpTo: 0, why: `${why ? `${why} ` : ''}The compact build with its modules failed (${e?.message || e}); built without the modules that read the whole store.` });
      }
    }
    lastThemes = (data.atlas?.themes || []).map((t) => t.tag);
    return data;
  };
  const dashCache = dashboardCache.createCache({
    build: () => dashboardData.collectDashboard(root, dashOptions(writesAllowed())),
    // Over FULL_BUILD_UP_TO_BYTES, or when the full build already failed at
    // this size in the worker (heap cap): the compact build — not minutes and
    // gigabytes again with every rebuild.
    buildInBackground: async () => {
      const bytes = dashboardCache.storeBytes(root, { env });
      const b = bytes?.build ?? null;
      if (b !== null && b > fullBuildMax) return compactBuild(b);
      if (fullFailed && b !== null && b >= fullFailed.bytes) return compactBuild(b, fullFailed.reason);
      try {
        return await dashboardCache.buildInWorker(root, { ...dashOptions(writesAllowed()), env: { ...env } });
      } catch (e) {
        const reason = `Full build failed (${e?.message || e}); the compact build runs instead.`;
        if (b !== null) fullFailed = { bytes: b, reason };
        return compactBuild(b, reason);
      }
    },
    // The quick head BEFORE the full build, while only the placeholder stands.
    // Not for a store the compact build serves: that one is built at once.
    buildHead: () => {
      const b = dashboardCache.storeBytes(root, { env })?.build ?? null;
      if (b !== null && b > fullBuildMax) return null;
      return lightBuild('First state since the start: only counters and newest entries, the full build is still running.');
    },
    // The write gate is part of the data (`writesAllowed`) — part of the stamp too.
    stamp: () => `${dashboardCache.generationStamp(root)}|w=${writesAllowed()}`,
    ...(syncUpToMsTest !== undefined ? { syncUpToMs: Number(syncUpToMsTest), minGapMs: Number(env.CHEAP_MEM_SERVE_CACHE_GAP_TEST_MS ?? 0) } : {}),
    // Serialize and pack the new state right away — otherwise the first
    // request afterwards would pay for packing.
    afterBackgroundBuild: () => { dashboardAnswerText(dashCache.get()).gzip(); },
    // Cold start without waiting for the full build: the head of the last
    // run from disk, otherwise (a small store) synchronously as before,
    // otherwise the placeholder.
    fromDisk: () => {
      const h = dashboardHead.readHead(root);
      if (h?.data?.atlas?.themes && !lastThemes.length) lastThemes = h.data.atlas.themes.map((t) => t.tag);
      return h;
    },
    syncAllowed: () => {
      const b = dashboardCache.storeBytes(root, { env })?.build ?? null;
      return b !== null && b <= dashboardCache.SYNC_UP_TO_BYTES;
    },
    placeholder: () => dashboardData.placeholder({ title: cfg.title, writesAllowed: writesAllowed() }),
  });
  // **The head per state (board-tempo-cm).** The first answer carries only
  // the newest entries + `overview`; the full, sorted list stays here for
  // `/dashboard/part.json?part=entries`. Computed once per state and (for a
  // real build) laid down on disk.
  let headState = null; // { id, head, sorted }
  const layDown = (st, head) => {
    try {
      dashboardHead.writeHead(root, head, { stamp: st.stamp ?? '', builtMs: Date.parse(st.meta.built_at), durationMs: st.meta.build_ms });
    } catch (err) {
      process.stderr.write(`serve: dashboard head could not be laid down: ${err?.message || err}\n`);
    }
  };
  function headOf(st) {
    if (headState?.id === st.id) return headState;
    const { data } = st;
    if (st.source !== 'build' || data.light || data.placeholder) {
      // The git and process state is LIVE, never from the last run: a head
      // from disk comes from another process (wrong "process stale" mark).
      const meta = { ...(data.meta ?? {}) };
      try { meta.git = consolePage.gitState(root); } catch { /* stays what it was */ }
      try { meta.code = dashboardData.codeState(); } catch { /* stays what it was */ }
      headState = { id: st.id, head: { ...data, meta }, sorted: null };
      // A light head is a real (partial) build: lay it down like any other.
      if (st.source === 'build' || st.source === 'head') layDown(st, headState.head);
      return headState;
    }
    // atlas-pass-cm: the pages of the condensed atlas and the rows outside the
    // window stay here, never in the answer (`samples`, `extras`).
    const { samples = null, extras = [], ...plain } = data;
    const head = { ...plain, parts: {} };
    // The deferred parts: list out, path and count in (readable ones only —
    // an unreadable section keeps its reason and has no list).
    for (const [name, p] of Object.entries(DEFERRED_PARTS)) {
      const list = partList(data, p);
      if (!p.readable(data) || !Array.isArray(list)) continue;
      if (p.section) {
        const { [p.field]: _gone, ...rest } = data[p.section];
        head[p.section] = rest;
      } else delete head[p.field];
      head.parts[name] = { path: `${dashboardPage.PATHS.part}?part=${name}`, count: list.length };
    }
    // `topics.list[].trail` holds the ids of EVERY entry of the topic (754 KB
    // at 100k entries) and no view reads it: the head carries the first few
    // and the count.
    if (Array.isArray(head.topics?.list)) {
      head.topics = { ...head.topics, list: head.topics.list.map((t) => (Array.isArray(t.trail) && t.trail.length > 8 ? { ...t, trail: t.trail.slice(0, 8), trailTotal: t.trail.length } : t)) };
    }
    const open = new Set([...(data.openDuties || []), ...(data.openQuestions || [])].map((x) => x.id));
    const e = dashboardHead.headEntries(data.entries || [], { open, max: headMax, route: entriesRoute, overview: data.compact ? data.overview : null });
    head.entries = e.entries;
    head.overview = e.overview;
    // The open duties and questions older than the compact window (the page names them).
    if (extras.length) {
      const inside = new Set(head.entries.map((x) => x.id));
      for (const x of extras) if (open.has(x.id) && !inside.has(x.id) && head.entries.length < headMax + 150) head.entries.push(x);
    }
    if (e.part) head.parts.entries = e.part;
    if (data.compact && data.atlas) head.parts.atlas = { path: `${dashboardPage.PATHS.part}?part=atlas`, page: dashboardPass.SAMPLE };
    headState = { id: st.id, head, sorted: e.sorted, samples, total: e.overview.count };
    layDown(st, head);
    return headState;
  }
  // --- atlas-pass-cm: pages of the condensed atlas ------------------------------
  // Zooming into a topic or a drawer asks for its entries, page by page. Order of
  // the sources: the sample of the pass (at once), the window of the newest
  // entries (at once, exact as soon as it holds enough hits — everything outside
  // is older), otherwise a search over the store in the build worker (memory
  // bounded); until it is done the answer is `searching`, never an empty list.
  const ATLAS_PAGE_MAX = 500;
  const ATLAS_DEPTH_MAX = 5000;
  const atlasSearches = new Map(); // key -> { result, error }
  function atlasAnswer(st, q) {
    const theme = q.get('theme') || null;
    const drawer = q.get('drawer') || null;
    const pq = q.get('project');
    const project = pq && pq !== 'all' ? pq : null;
    const base = { part: 'atlas', theme, drawer, project, cache: st.meta };
    const unknown = (reason, extra = {}) => ({ state: 'unknown', ...base, data: null, reason, ...extra });
    if (!theme === !drawer) return unknown('give exactly one of theme or drawer');
    const from = Math.max(0, Math.floor(Number(q.get('from')) || 0));
    const n = Math.min(ATLAS_PAGE_MAX, Math.max(1, Math.floor(Number(q.get('n')) || dashboardPass.SAMPLE)));
    if (from + n > ATLAS_DEPTH_MAX) return unknown(`deeper than ${ATLAS_DEPTH_MAX} entries of one topic only through the search`);
    const hs = headOf(st);
    if (!hs.sorted) return unknown((st.data.reasons || [])[0] || 'head only', { head_only: true });
    const fits = (r) => (theme
      ? (theme === dashboardPass.NO_THEME ? !(r.tags || []).length : (r.tags || []).includes(theme))
      : `${r.project}/${r.type}` === drawer) && (!project || r.project === project);
    const pageOf = (list, total, source) => {
      const data = list.slice(from, from + n);
      return { state: 'ok', ...base, from, n: data.length, data, total, next: from + data.length < total ? from + data.length : null, source, state_id: st.id };
    };
    if (!st.data.compact) {
      const list = hs.sorted.filter(fits);
      return pageOf(list, list.length, 'list');
    }
    const at = st.data.atlas || {};
    const node = theme ? (at.themes || []).find((t) => t.tag === theme) : (at.drawers || []).find((d) => d.drawer === drawer);
    const count = node ? (project && theme ? (node.perProject?.[project] ?? 0) : node.count) : null;
    const sample = (hs.samples?.get(theme ? `theme:${theme}` : `drawer:${drawer}`) || []).filter(fits);
    if (node?.sampleWhole !== false && (from + n <= sample.length || (count !== null && sample.length >= count))) return pageOf(sample, count ?? sample.length, 'sample');
    const inWindow = hs.sorted.filter(fits);
    if (inWindow.length >= from + n || (count !== null && inWindow.length >= count)) return pageOf(inWindow, count ?? inWindow.length, 'window');
    const key = JSON.stringify([st.id, theme, drawer, project, from + n]);
    const found = atlasSearches.get(key);
    if (found?.result) return pageOf(found.result.rows.map((z) => dashboardData.entryRow(z, null, z.count ?? null)), found.result.total, 'search');
    if (found?.error) return unknown(`search failed: ${found.error}`);
    if (!found) {
      while (atlasSearches.size >= 50) atlasSearches.delete(atlasSearches.keys().next().value);
      const slot = { result: null, error: null };
      atlasSearches.set(key, slot);
      dashboardCache.buildInWorker(root, { kind: 'atlasPage', theme, drawer, project, max: from + n })
        .then((r) => { slot.result = r; }, (err) => { slot.error = err?.message || String(err); });
    }
    return unknown('the page is being searched in the store', { searching: true });
  }
  const taskEndSeen = new Set(); // task ids whose end already invalidated the cache
  let dashText = null; // { key, plain, gzip() } — the last serialized text
  const packedPerVersion = new Map(); // 'path:version' -> gzip of a page file (tempo)
  function dashboardAnswerText(st) {
    // dash-fix3 parity: append "live checked" (mcplive.mjs) and "client
    // visible" (mcpvisibility.mjs) to catalog.mcp. Both only ADD to what
    // catalog.mcp already carries from src/mcpprofile.mjs — nothing here
    // is invented.
    //
    // **Strictly synchronous, on purpose.** This route never had to
    // wait on anything before this probe — an `await` here would
    // regress that. `mcplive.probe()` itself stays async (it speaks
    // HTTP to the bridge); it runs in the BACKGROUND
    // (`mcplive.kickProbe`, fire-and-forget, at most one at a time) and
    // this response only reads what is already cached
    // (`mcplive.probeNow`, no network). Right after start that is
    // nothing yet — then "unknown" with a reason, like any other
    // not-yet-measured value; the NEXT call sees the result that
    // arrived meanwhile.
    //
    // tempo: the cached data is NOT modified (it serves many answers) —
    // the live fields go into a copy of `catalog.mcp`.
    const data = headOf(st).head;
    let mcpNew = null;
    try {
      const mcp = data.catalog?.mcp;
      if (mcp) {
        mcpNew = { ...mcp };
        const defined = [...(mcp.reading || []), ...(mcp.writing || [])];
        const result = mcplive.probeNow();
        if (result) {
          mcpNew.live = mcplive.verdicts(result, defined);
          mcpNew.liveCheckedAt = result.checkedAt;
          mcpNew.liveReason = result.reachable ? null : result.reason;
        } else {
          mcpNew.live = mcplive.verdicts({ reachable: false, reason: 'not checked yet' }, defined);
          mcpNew.liveCheckedAt = null;
          mcpNew.liveReason = 'not checked yet';
          mcplive.kickProbe({ env });
        }
        const seen = mcpvisibility.latestPerTool(root);
        mcpNew.clientVisible = Object.fromEntries(defined.map((n) => {
          const x = seen.get(n);
          return [n, x ? { client: x.client, ts: x.ts } : null];
        }));
      }
    } catch (e) {
      if (data.catalog?.mcp) mcpNew = { ...data.catalog.mcp, liveReason: e?.message || String(e) };
    }
    // cat-confirm-cm: the categories come LIVE from the small category logs, not from the cache (which
    // trails a click until the next build). The stamp is a stat on five files.
    const catStamp = dashboardData.categoriesStamp(root);
    const key = JSON.stringify([st.id, mcpNew && {
      live: mcpNew.live, at: mcpNew.liveCheckedAt, reason: mcpNew.liveReason, seen: mcpNew.clientVisible,
    }, st.meta, catStamp]);
    if (dashText?.key === key) return dashText;
    const whole = mcpNew ? { ...data, catalog: { ...data.catalog, mcp: mcpNew } } : { ...data };
    try { if (whole.categories) whole.categories = dashboardData.categoriesLive(root, whole.categories); } catch { /* the stored state stays */ }
    whole.cache = st.meta;
    const plain = JSON.stringify(whole);
    let packed = null;
    dashText = { key, plain, gzip: () => (packed ??= zlib.gzipSync(plain)) };
    return dashText;
  }

  function handler(req, res) {
    let url;
    try { url = new URL(req.url, 'http://x'); }
    catch { res.writeHead(400).end('bad request'); return; }

    // Health: no auth, so a tunnel or a supervisor can check without
    // knowing the token. It reveals nothing about the content.
    if (url.pathname === '/health') {
      res.writeHead(200, { 'content-type': 'text/plain; charset=utf-8' }).end('ok');
      return;
    }

    if (!PATHS.includes(url.pathname)) {
      res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }).end('not found');
      return;
    }

    // Destructured rather than read as a property of `cfg`: the secret
    // latch flags a property read off a config object ON PURPOSE — such
    // an object really can hold an inlined literal — and the right
    // answer to a rule one disagrees with is not to loosen it.
    const { token } = cfg;
    const decision = webauth.authDecision({
      token,
      given: tokenFrom(req, url),
      remoteLoopback: webauth.remoteIsLoopback(req),
    });
    if (!decision.allowed) {
      // **Invisible principle**: no valid token gets EXACTLY the answer
      // an unknown path gets — a bare 404. No "token required", no
      // product name, no 401 that would reveal something guarded is
      // here. A scanner sees "nothing".
      res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }).end('not found');
      return;
    }

    // Token arrived as ?k= → set it as a cookie and redirect without the
    // query, so the secret leaves the address bar and the history.
    // SameSite=Lax, not Strict: the path may lead through an identity
    // provider and back, which is a cross-site top-level navigation.
    if (decision.setCookie && url.searchParams.get('k')) {
      res.writeHead(302, {
        'set-cookie': `mem_k=${encodeURIComponent(url.searchParams.get('k'))}`
          + '; Path=/; Max-Age=34560000; HttpOnly; Secure; SameSite=Lax',
        location: '/',
      }).end();
      return;
    }

    // --- The password (src/login.mjs) ---------------------------------
    //
    // Behind the token door, in front of all content. Without a valid
    // session (or a valid bearer CHEAP_MEM_SERVE_TOKEN for tools/tests):
    // every page -> /login, every data and writing route -> 401 JSON.
    // Only the mark, the worker and the fonts stay free (no memory
    // content; the worker must update for signed-out browsers too).
    if (loginOn) {
      if (!loginFree.includes(url.pathname)) {
        let answered;
        try { answered = login.gate(req, res, url, { ...loginCtx, bearer: webauth.bearerFrom(req) }); } catch (e) {
          res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: 'login-broken' }));
          process.stderr.write(`serve: login gate threw: ${e?.message || e}\n`);
          return;
        }
        if (answered) return;
      }
    } else if (login.ALL_PATHS.includes(url.pathname)) {
      res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }).end('not found');
      return;
    }

    // --- The dashboard: its files, the fonts, the PWA shell ------------
    //
    // BEHIND the door like everything else: a `<script src>` carries the
    // same cookies as the page, and whoever may not see the page needs
    // neither its script nor its font. No memory content is in any of
    // them — it is code; the data comes separately through
    // `/dashboard.json`.
    const shipped = dashboardPage.FILES[url.pathname]
      ?? dashboardPage.FONTS.map((f) => ({ ...f, type: 'font/woff2' })).find((f) => f.path === url.pathname);
    if (shipped) {
      let bytes;
      try { bytes = fs.readFileSync(path.join(PACKAGE_ROOT, shipped.file)); } catch (e) {
        res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
          .end(`file ${shipped.file} not readable: ${e?.message || e}`);
        return;
      }
      // The fonts carry their version in the name and never change.
      if (url.pathname.startsWith('/fonts/')) {
        res.writeHead(200, {
          'content-type': shipped.type, 'x-content-type-options': 'nosniff',
          'cache-control': 'private, max-age=31536000, immutable',
        }).end(bytes);
        return;
      }
      // **tempo (2026-09-28): a version mark instead of reloading.** The
      // page asks `?v=<sha256 prefix>` (`dashboardPage.version()`). When
      // the mark matches the content the browser may keep the file for a
      // year (`immutable`) — a new version has a new mark, so a new
      // address. Without a mark or with a foreign one: `no-cache` WITH an
      // ETag, so a cheap 304 instead of the whole file. Packed when the
      // browser offers it, once per version (`packedPerVersion`).
      const v = dashboardPage.version(url.pathname);
      const etag = v ? `"${v}"` : null;
      const head = {
        'content-type': shipped.type,
        'x-content-type-options': 'nosniff',
        'cache-control': v && url.searchParams.get('v') === v ? 'private, max-age=31536000, immutable' : 'no-cache',
        vary: 'accept-encoding',
      };
      if (etag) head.etag = etag;
      if (etag && String(req.headers['if-none-match'] ?? '').split(/\s*,\s*/).includes(etag)) {
        res.writeHead(304, head).end();
        return;
      }
      if (v && /\bgzip\b/.test(String(req.headers['accept-encoding'] ?? ''))) {
        const k = `${url.pathname}:${v}`;
        let gz = packedPerVersion.get(k);
        if (!gz) { gz = zlib.gzipSync(bytes); packedPerVersion.set(k, gz); }
        res.writeHead(200, { ...head, 'content-encoding': 'gzip' }).end(gz);
        return;
      }
      res.writeHead(200, head).end(bytes);
      return;
    }
    if (url.pathname === dashboardPage.PATHS.swRegister) {
      res.writeHead(200, { 'content-type': 'text/javascript; charset=utf-8', 'x-content-type-options': 'nosniff', 'cache-control': 'no-cache' })
        .end(pwa.REGISTER_SCRIPT);
      return;
    }
    // `/favicon.ico` — the path every browser asks on its own. The mark
    // is already a data: URI in the page's head; this answers the extra
    // request from the SAME drawing (`icon.mark`), so the console does
    // not carry a standing 404 that teaches people to ignore it.
    if (url.pathname === '/favicon.ico') {
      const png = icon.mark(32, { dark: true });
      res.writeHead(200, { 'content-type': 'image/png', 'cache-control': 'public, max-age=86400', 'content-length': png.length }).end(png);
      return;
    }
    if (url.pathname === '/manifest.webmanifest') {
      res.writeHead(200, { ...HEAD, 'content-type': 'application/manifest+json; charset=utf-8' })
        .end(JSON.stringify(pwa.manifest({ title: cfg.title })));
      return;
    }
    if (url.pathname === '/sw.js') {
      // Not no-store: a worker the browser may not keep is fetched anew
      // on every start. Short is enough, and script is not memory content.
      res.writeHead(200, {
        'content-type': 'text/javascript; charset=utf-8', 'cache-control': 'max-age=0, must-revalidate',
        'referrer-policy': 'no-referrer', 'x-content-type-options': 'nosniff',
      }).end(pwa.serviceWorker({ offline: cfg.offline === true }));
      return;
    }

    // --- The dashboard: the Host check for every data route ------------
    if (HOST_GUARDED.includes(url.pathname) && !hostOk(req.headers.host, cfg)) {
      res.writeHead(403, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify({ state: 'error', reason: 'foreign-host' }));
      return;
    }

    // --- The dashboard: the page and its data ---------------------------
    if (url.pathname === dashboardPage.PATHS.page || url.pathname === '/') {
      let html;
      try {
        let workspace = {};
        try {
          const c = memConfig.readConfig(root);
          workspace = { name: c.name || path.basename(path.resolve(root)), human: memConfig.humanParticipant(c.participants).name ?? null };
        } catch { workspace = { name: path.basename(path.resolve(root)), human: null }; }
        html = pwa.insertHead(dashboardPage.asHtml({
          title: cfg.title, writesAllowed: writegate.read(root, gateOpts(cfg)).allowed, workspace, loginEnabled: loginOn,
          // no-jump: TEST ONLY — shortens the dashboard script's quiet
          // refetch intervals (otherwise 5000/20000 ms). Unchanged in
          // normal operation.
          tempoTestMs: Number(env.CHEAP_MEM_SERVE_TEMPO_TEST_MS || 0) || null,
        }));
      } catch (e) {
        res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
          .end(`dashboard could not be built: ${e?.message || e}`);
        return;
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'text/html; charset=utf-8', 'content-security-policy': CSP }).end(html);
      return;
    }
    if (url.pathname === dashboardPage.PATHS.data) {
      // **tempo (2026-09-28): from the cache.** Built only on the first
      // request (synchronously, as before) and afterwards when the store
      // changed — for a large store in the background
      // (src/dashboard-cache.mjs). The answer says itself how old it is and
      // whether a rebuild is running (`cache`).
      let text;
      try {
        text = dashboardAnswerText(dashCache.get());
      } catch (e) {
        res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'error', reason: e?.message || String(e) }));
        return;
      }
      // Packed only when the browser offers it — a script without gzip
      // gets plain text. Packed once per version of the text, not per request.
      if (/\bgzip\b/.test(String(req.headers['accept-encoding'] ?? ''))) {
        res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8', 'content-encoding': 'gzip', vary: 'accept-encoding' })
          .end(text.gzip());
      } else {
        res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' }).end(text.plain);
      }
      return;
    }
    // Full-text search for the search field of the knowledge view
    // (src/fulltext.mjs): the same gates as /dashboard.json (token door
    // above, Host check in HOST_GUARDED, no CORS header). GET ?q=... ->
    // { ids, measurable:true } or, on a failure, { measurable:false,
    // reason } — never an empty list for "not read". Empty query: ids:null.
    // The index hangs on the same generation stamp as the dashboard cache.
    // F23: paged (?limit=, ?cursor=; the answer carries more/cursor/generation),
    // the event loop stays free; on a new store state the request waits
    // for the rebuild (in slices) - the old index is never served, it could
    // still show a destroyed or removed entry.
    if (url.pathname === fulltext.PATH) {
      fulltext.answer(root, url.searchParams.get('q') || '', {
        limit: url.searchParams.get('limit'),
        cursor: url.searchParams.get('cursor'),
        aborted: () => res.destroyed || res.socket?.destroyed === true,
      }).then((found) => {
        if (res.destroyed) return;
        res.writeHead(found.measurable ? 200 : 500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify(found));
      });
      return;
    }
    // tempo: one deferred part — the same gates as /dashboard.json (the
    // token door above, the Host check in HOST_GUARDED, no CORS header),
    // the same source (the cached build), the same freshness statement.
    if (url.pathname === dashboardPage.PATHS.part) {
      const name = url.searchParams.get('part') || '';
      const p = Object.hasOwn(DEFERRED_PARTS, name) ? DEFERRED_PARTS[name] : null;
      if (!p && name !== 'entries' && name !== 'atlas') {
        res.writeHead(404, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'unknown', reason: `no deferred part '${name}' (known: ${[...Object.keys(DEFERRED_PARTS), 'entries', 'atlas'].join(', ')})` }));
        return;
      }
      let st;
      try { st = dashCache.get(); } catch (e) {
        res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'error', reason: e?.message || String(e) }));
        return;
      }
      // board-tempo-cm: before the first real build (a head from disk, a
      // quick head or the placeholder) there is no list — "unknown" with
      // `building`, the page asks again later; never an empty list.
      let found;
      if (st.source !== 'build') {
        found = { state: 'unknown', part: name, data: null, building: true, reason: st.meta.reason || 'list not built yet', cache: st.meta };
      } else if (name === 'atlas') {
        found = atlasAnswer(st, url.searchParams);
      } else if (name === 'entries' && !headOf(st).sorted) {
        // Light head: this state has no full list.
        found = { state: 'unknown', part: name, data: null, head_only: true, reason: (st.data.reasons || [])[0] || 'head only', cache: st.meta };
      } else if (name === 'entries') {
        // Page by page from the sorted list of THIS state; `state_id` lets
        // the page notice when a rebuild happened between two pages.
        found = { state: 'ok', part: name, ...dashboardHead.page(headOf(st).sorted, url.searchParams.get('from'), url.searchParams.get('n'), { total: headOf(st).total }), state_id: st.id, cache: st.meta };
      } else {
        const list = partList(st.data, p);
        found = p.readable(st.data) && Array.isArray(list)
          ? { state: 'ok', part: name, data: list, cache: st.meta }
          : { state: 'unknown', part: name, data: null, reason: (p.section && st.data[p.section]?.reason) || `${p.section ?? p.field} not readable`, cache: st.meta };
      }
      const body = JSON.stringify(found);
      if (/\bgzip\b/.test(String(req.headers['accept-encoding'] ?? ''))) {
        res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8', 'content-encoding': 'gzip', vary: 'accept-encoding' })
          .end(zlib.gzipSync(body));
      } else {
        res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' }).end(body);
      }
      return;
    }
    // **Project package (#sources/export, parity with lucky-mem 2026-10-01).**
    // Read only, the same gates as /dashboard.json (token door and login
    // above, Host check in HOST_GUARDED, no CORS header), GET only. The
    // selection comes from THE SAME build as /dashboard.json
    // (src/projectpackage.mjs select()); `?preview=1` answers only the counts
    // for the page's content preview, otherwise the whole package as a file
    // (Content-Disposition). Encrypted stays ciphertext, plaintext runs
    // through src/redaction.mjs.
    // The skill catalogue: read only; canSetStatus needs writing on AND a
    // password session (the token is not a person). Writes go via /task.
    if (url.pathname === dashboardPage.PATHS.skills) {
      const json = (code, o) => res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' }).end(JSON.stringify(o));
      if (req.method !== 'GET' && req.method !== 'HEAD') { json(405, { state: 'error', reason: 'GET only' }); return; }
      const w = writesAllowed();
      const person = personSignedIn(req);
      let body;
      try {
        body = skillcatalog.catalogue(root, {
          env, effect: skillEffect(), canSetStatus: w && person,
          noButtonReason: !w ? 'writing from the page is off (mem serve --allow-writes)' : (person ? null : 'no password session (a token is not a person)'),
        });
      } catch (e) { json(500, { state: 'error', reason: e?.message || String(e) }); return; }
      json(200, body);
      return;
    }
    // The calendar: read only (appointments/ is written by `mem appointment` and the MCP tools).
    // One answer: the overview (appointments, occurrences, banner, today, cap) plus the outlet's state.
    if (url.pathname === dashboardPage.PATHS.appointments) {
      const json = (code, o) => res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' }).end(JSON.stringify(o));
      if (req.method !== 'GET' && req.method !== 'HEAD') { json(405, { state: 'error', reason: 'GET only' }); return; }
      let body;
      try {
        const v = appointmentToday.overview(root, {});
        let outlet = null;
        try {
          const st = appointmentInvite.status(root, { env });
          outlet = { active: st.active, reason: st.reason, route: st.config?.route ?? null, sent: st.sentTotal, open: st.open.length, gaveUp: st.gaveUp, credentialOk: st.credential ? st.credential.ok : null };
        } catch { outlet = null; }
        body = { ...v, outlet, empty: v.appointments.length === 0 };
      } catch (e) { json(500, { state: 'error', reason: e?.message || String(e) }); return; }
      json(200, body);
      return;
    }
    if (url.pathname === dashboardPage.PATHS.projectPackage) {
      const json = (code, o, extra = {}) => res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8', ...extra }).end(JSON.stringify(o));
      if (req.method !== 'GET' && req.method !== 'HEAD') { json(405, { state: 'error', reason: 'GET only' }, { allow: 'GET' }); return; }
      let known;
      try { known = memoryModule.listProjects(root); } catch (e) { json(500, { state: 'error', reason: e?.message || String(e) }); return; }
      const a = projectPackage.checkRequest(url.searchParams, known);
      if (!a.ok) { json(a.code, { state: a.code === 404 ? 'unknown' : 'error', reason: a.reason }); return; }
      let st;
      try { st = dashCache.get(); } catch (e) { json(500, { state: 'error', reason: e?.message || String(e) }); return; }
      // board-tempo-cm: a head from disk / a quick head / the placeholder (or
      // a light head) does not carry every entry — a package from it would be
      // silently incomplete. Refused honestly, the caller asks again.
      // atlas-pass-cm: the compact build holds only the newest window, without free
      // text — a package from it would be silently incomplete.
      if (st.source === 'build' && st.data.compact) { json(503, { state: 'unknown', reason: 'the project package needs the full build; this store is built compact (drawers over the full-build line, or the full build failed)', cache: st.meta }); return; }
      if (st.source !== 'build' || st.data.light) { json(503, { state: 'unknown', building: true, reason: st.meta.reason || (st.data.reasons || [])[0] || 'not built yet', cache: st.meta }); return; }
      if (url.searchParams.get('preview') === '1') {
        json(200, { ...projectPackage.preview(st.data, a), cache: st.meta });
        return;
      }
      let pkg;
      const now = new Date();
      try { pkg = projectPackage.build(root, st.data, a, { cache: st.meta, now }); } catch (e) {
        json(500, { state: 'error', reason: e?.message || String(e) }); return;
      }
      // Offline reading view (dash-paket-cm): the SAME package as one self-contained
      // HTML file (src/readview.mjs) — same selection, redaction and count.
      const asHtml = url.searchParams.get('format') === 'html';
      const text = asHtml ? readview.buildHtml(pkg) : JSON.stringify(pkg, null, 1);
      const head = {
        ...HEAD, 'content-type': asHtml ? 'text/html; charset=utf-8' : 'application/json; charset=utf-8',
        'content-disposition': `attachment; filename="${asHtml ? readview.fileName(a.project, now) : projectPackage.fileName(a.project, now)}"`,
      };
      if (/\bgzip\b/.test(String(req.headers['accept-encoding'] ?? ''))) {
        res.writeHead(200, { ...head, 'content-encoding': 'gzip', vary: 'accept-encoding' }).end(zlib.gzipSync(text));
      } else res.writeHead(200, head).end(text);
      return;
    }
    // One entry whole (card + raw line) — for the dashboard's detail drawer.
    if (url.pathname === dashboardPage.PATHS.entry) {
      const id = url.searchParams.get('id') || '';
      try { backlinkIndex.update(root); } catch { /* the reason comes through the card */ }
      let found;
      try { found = dashboardData.entryWhole(root, id); } catch (e) {
        found = { state: 'error', id, reason: e?.message || String(e) };
      }
      const code = { ok: 200, warning: 200, unknown: 404, error: 500 }[found.state] ?? 500;
      res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' }).end(JSON.stringify(found));
      return;
    }
    // One message whole, with the replies to it — read-only: opening it
    // acknowledges NOTHING (that stays a POST to /inbox/state).
    if (url.pathname === dashboardPage.PATHS.message) {
      const name = url.searchParams.get('name') || '';
      let found;
      try { found = dashboardData.messageWhole(root, name); } catch (e) {
        found = { state: 'unknown', reason: e?.message || String(e) };
      }
      res.writeHead(found.state === 'ok' ? 200 : 404, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(found));
      return;
    }
    // The retrieval probe: `mem retrieve`, read-only. The question is not
    // logged — no console line, no journal, no observation.
    if (url.pathname === dashboardPage.PATHS.probe) {
      if (req.method !== 'GET' && req.method !== 'POST') {
        res.writeHead(405, { allow: 'GET, POST', 'content-type': 'text/plain; charset=utf-8' }).end('GET/POST only');
        return;
      }
      const answer = (q) => {
        let found;
        try { found = dashboardData.retrievalProbe(root, q); } catch (e) {
          found = { state: 'error', reason: e?.message || String(e) };
        }
        res.writeHead(found.state === 'ok' ? 200 : 400, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify(found));
      };
      if (req.method === 'GET') { answer(url.searchParams.get('question') || ''); return; }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      readBoundedBody(req, res, 8192, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) {
          res.writeHead(413, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: 'too-big' }));
          return;
        }
        answer(new URLSearchParams(body).get('question') || '');
      });
      return;
    }
    // knowledge/facts: the bitemporal comparison. Read-only GET.
    if (url.pathname === dashboardPage.PATHS.factsAt) {
      if (req.method !== 'GET') {
        res.writeHead(405, { allow: 'GET', 'content-type': 'text/plain; charset=utf-8' }).end('GET only');
        return;
      }
      let found;
      try {
        found = dashboardData.factsAt(root, {
          known: url.searchParams.get('known') || '', valid: url.searchParams.get('valid') || '',
        });
      } catch (e) { found = { state: 'error', reason: e?.message || String(e) }; }
      const code = found.state === 'ok' ? 200 : 400;
      res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' }).end(JSON.stringify(found));
      return;
    }

    // --- Acknowledge one message (set its state) ------------------------
    //
    // The same write `mem inbox ack` makes (`inbox.setState`). Only a
    // message addressed to the configured human participant can be
    // acknowledged from here — the same rule as `/inbox/reply`: no form
    // field decides who speaks. Behind `writegate.refusal()`.
    if (url.pathname === '/inbox/state') {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' }).end('POST only');
        return;
      }
      const no = writegate.refusal(root, cfg, req);
      if (no) { short(res, no.code, no.text); return; }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      readBoundedBody(req, res, 4096, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) { short(res, 413, 'Too much.'); return; }
        const form = new URLSearchParams(body);
        const name = form.get('name') ?? '';
        const state = form.get('state') ?? '';
        try {
          const { participants } = memConfig.readConfig(root);
          const { name: humanName, reason } = memConfig.humanParticipant(participants);
          if (!humanName) { short(res, 400, reason); return; }
          const original = inbox.parse(inbox.readMessage(root, name));
          if (original.to !== humanName) {
            short(res, 400, `'${name}' is addressed to '${original.to}', not to '${humanName}' — only its recipient can acknowledge it`);
            return;
          }
          // Z3/A8: an event line; `by` is the human participant, never a form field.
          inbox.setState(root, participants, name, state, { by: humanName });
        } catch (e) {
          short(res, 400, e?.message || String(e));
          return;
        }
        res.writeHead(303, { location: '/' }).end();
      });
      return;
    }

    // --- Writing paths -------------------------------------------------
    //
    // Exactly four, and each one starts with `writegate.refusal()`:
    //   POST /setting      set one knob from console.SETTINGS
    //   POST /task         start a long CLI job as a child process
    //   POST /task/cancel  end one
    //   POST /inbox/reply  answer one message in the human's tray (P1b)
    // Every other path only reads. `WRITE_PATHS` above is the list the
    // probes check against; a fifth writing route belongs in it.

    // --- Setting --------------------------------------------------------
    if (url.pathname === '/setting') {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      // The write switch, then readonly, Host, Origin — all in ONE
      // function (`src/writegate.mjs`), shared by every writing route.
      const no = writegate.refusal(root, cfg, req);
      if (no) { short(res, no.code, no.text); return; }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      // A cap, so a form cannot fill the process. Two named fields do
      // not need a kilobyte.
      readBoundedBody(req, res, 8192, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) { short(res, 413, 'Too much.'); return; }
        const p = new URLSearchParams(body);
        try {
          consolePage.apply(root, p.get('id') ?? '', p.get('value') ?? '', { by: 'console' });
        } catch (e) {
          short(res, 400, e?.message || String(e));
          return;
        }
        // Redirect after writing, rather than rendering: otherwise a
        // reload applies the same change again.
        // Back to the page the form was on. A CLOSED list, not the
        // submitted value: an open redirect target is how a form field
        // becomes a way to send someone somewhere else.
        // Back to the dashboard: the only page there is (a CLOSED target,
        // never the submitted value — an open redirect target is how a
        // form field becomes a way to send someone somewhere else).
        res.writeHead(303, { location: '/' }).end();
      });
      return;
    }

    // --- Verify verdict (N9 parity, 2026-09-28) --------------------------
    //
    // A human's judgement on ONE "to verify" candidate from the Today
    // card (src/today.mjs part c: a timeline fact flagged stale or in
    // conflict — never a fabricated gold question, cheap-mem has no
    // such source, see today.mjs's own header). The ONLY effect: ONE
    // line appended to src/verifylog.mjs's target file OUTSIDE this
    // memory (`CHEAP_MEM_VERIFY_FILE`, else `~/.cheap-mem-verify/
    // facts-verdict.jsonl`) — append-only, never a correction on the
    // entry, never a write inside this repository. Same gate as every
    // other writing route (`writegate.refusal()`) plus the outside-root
    // check `verifylog.append()` runs before touching the filesystem.
    if (url.pathname === VERIFY_VERDICT_PATH) {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      const no = writegate.refusal(root, cfg, req);
      if (no) {
        res.writeHead(no.code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'error', reason: no.text }));
        return;
      }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      // A verdict is a key, a verdict word and a couple of small
      // fields — nowhere near a kilobyte.
      readBoundedBody(req, res, 4096, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) {
          res.writeHead(413, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: 'Too much.' }));
          return;
        }
        const p = new URLSearchParams(body);
        const row = verifylog.buildRow({
          key: p.get('key') || null,
          project: p.get('project') || null,
          verdict: p.get('verdict') || null,
          ageDays: p.get('ageDays') ? Number(p.get('ageDays')) : null,
          conflict: p.get('conflict') === '1',
          note: p.get('note') || null,
        });
        const target = verifylog.targetPath(env);
        let result;
        try {
          result = verifylog.append(target, root, row);
        } catch (e) {
          res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: e?.message || String(e) }));
          return;
        }
        if (!result.written) {
          res.writeHead(400, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: result.defects.join('; ') }));
          return;
        }
        res.writeHead(201, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'ok', written: true, id: result.row.id }));
      });
      return;
    }

    // --- Gold verdict (N9 parity, "gold nebenbei"/"Rate today") ----------
    //
    // A human's judgement on ONE real retrieval-question candidate drawn
    // by `src/goldlog.mjs` (a hit/near-miss/no-hit outcome from the
    // injection journal, correlated with a real user message). The ONLY
    // effect: ONE line appended to goldlog's target file OUTSIDE this
    // memory (`CHEAP_MEM_GOLD_FILE`, else `~/.cheap-mem-gold/
    // retrieval-gold.jsonl`) — append-only, never a change in this repo,
    // never the question text echoed back. Same gate as every other
    // writing route, plus the outside-root check `goldlog.append()` runs.
    if (url.pathname === GOLD_VERDICT_PATH) {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      const no = writegate.refusal(root, cfg, req);
      if (no) {
        res.writeHead(no.code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'error', reason: no.text }));
        return;
      }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      readBoundedBody(req, res, 4096, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) {
          res.writeHead(413, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: 'Too much.' }));
          return;
        }
        const p = new URLSearchParams(body);
        const verdict = p.get('verdict') || null;
        const occasion = p.get('occasion') || null;
        const source = p.get('source') || null;
        const candidateId = p.get('id') || null;
        let expected;
        try { expected = JSON.parse(p.get('expected') ?? '[]'); } catch { expected = null; }
        if (!Array.isArray(expected) || !expected.every((x) => typeof x === 'string')) {
          res.writeHead(400, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: 'expected is not a JSON array of strings' }));
          return;
        }
        // A row we are CORRECTING (it already has an id from a previous
        // draw) gets `replaces_id`, never a rewrite (append-only).
        const row = goldlog.buildRow({
          question: null,
          share: 'no',
          expected,
          occasion,
          source,
          kind: 'drawn',
          verdict,
          replacesId: candidateId || undefined,
        });
        const target = goldlog.targetPath(env);
        let result;
        try {
          result = goldlog.append(target, root, row);
        } catch (e) {
          res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: e?.message || String(e) }));
          return;
        }
        if (!result.written) {
          res.writeHead(400, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
            .end(JSON.stringify({ state: 'error', reason: result.defects.join('; ') }));
          return;
        }
        res.writeHead(201, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'ok', written: true, id: result.row.id }));
      });
      return;
    }

    // --- Reply from the inbox (P1b) -------------------------------------
    //
    // The same write `mem inbox write` makes: `inbox.reply()` reads the
    // original, turns its header around and calls `inbox.write()` — no
    // second message format. The form sends only the message NAME and
    // the text; who answers is the desk's human participant — the one
    // `memConfig.humanParticipant()` finds marked `"human": true` in
    // `.mem/config.json`'s `participants`, never a hardcoded key — and
    // the recipient is read from the original file. A message not
    // addressed to that participant is refused (400); a memory with no
    // human marked (or more than one) is refused (400) with the reason.
    // Nothing is committed or pushed, exactly like the CLI.
    if (url.pathname === '/inbox/reply') {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      // The write switch, then readonly, Host, Origin — all in ONE
      // function (`src/writegate.mjs`), shared by every writing route.
      const no = writegate.refusal(root, cfg, req);
      if (no) { short(res, no.code, no.text); return; }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      // A reply is a few paragraphs; 16 KB is room for that and a cap
      // so a form cannot fill the process.
      readBoundedBody(req, res, 16384, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) { short(res, 413, 'Too much.'); return; }
        const form = new URLSearchParams(body);
        const text = form.get('text') ?? '';
        if (!text.trim()) { short(res, 400, 'Empty reply — nothing written.'); return; }
        try {
          const { participants } = memConfig.readConfig(root);
          const { name: humanName, reason } = memConfig.humanParticipant(participants);
          if (!humanName) { short(res, 400, reason); return; }
          inbox.reply(root, participants, {
            name: form.get('name') ?? '', as: humanName, text,
          });
        } catch (e) {
          short(res, 400, e?.message || String(e));
          return;
        }
        // Redirect after writing, so a reload does not send it twice.
        // A CLOSED target, like `/setting`'s: the desk, nothing else.
        res.writeHead(303, { location: '/' }).end();
      });
      return;
    }

    // --- The console --------------------------------------------------
    //
    // It used to live at `/`. The desk took that place on 2026-09-16;
    // the console kept everything it could do and moved one door along.
    // `/console.json` answers unchanged — probes and the setup check
    // read it, and changing a shape while changing a look turns two
    // separable mistakes into one indistinguishable one.
    if (url.pathname === '/console.json') {
      let data;
      try { data = consolePage.collect(root, { env, cfg }); }
      catch (e) {
        res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
          .end(`console could not be built: ${e?.message || e}`);
        return;
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(data));
      return;
    }

    // --- One entry, without building the desk (D1, 2026-09-27) -------
    //
    // Until this route existed, the only way to look up ONE entry over
    // this server was `/dashboard.json` (now `/desk.json`), which builds every view,
    // every drawer, every project — to hand back one row. This route
    // resolves the id directly through `dashboard.getEntryFast()` (see
    // its header comment in `src/dashboard.mjs` for the full contract
    // and the one search it deliberately skips); it never touches
    // `dashboard.collect()` or `collectDashboard()`.
    //
    // Same four states dashboard.getEntryFast() returns, mapped to
    // HTTP the same way lucky-mem's `/eintrag.json` mirror maps
    // `zustand:gut/unbekannt/fehler/warnung` — 'ok'/'warning' both answer
    // 200 (found, one of them with a disclosed gap), 'unknown' answers
    // 404, 'error' answers 500. No fallback: a state this route does
    // not recognise is a bug in `getEntryFast()`, not something to
    // paper over here.
    //
    // D1b: bring the backlink index up to date first — `backlinks.
    // update()` only stats the drawers and rebuilds ONLY when the corpus
    // changed since the last build (the `search.loadIndex` pattern). If
    // that fails, `getEntryFast()` itself answers 'warning' with the
    // reason; the entry does not go missing over it.
    if (url.pathname === '/entry.json') {
      const id = url.searchParams.get('id') || '';
      try { backlinkIndex.update(root); } catch { /* reason surfaces through getEntryFast() */ }
      let found;
      try { found = dashboard.getEntryFast(root, id); } catch (e) {
        res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'error', id, reason: e?.message || String(e) }));
        return;
      }
      const code = { ok: 200, warning: 200, unknown: 404, error: 500 }[found.state];
      if (!code) throw new Error(`getEntryFast() answered an unknown state '${found.state}'`);
      res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(found));
      return;
    }

    // --- D3b: the same list as a page the server renders ---------------
    // (src/entries-page.mjs). Same filters, same cursor, same
    // `pages.page()`; Host check in HOST_GUARDED, no CORS header, no script.
    if (url.pathname === entriesPage.PATH) {
      const { status, html } = entriesPage.render(root, url.searchParams);
      res.writeHead(status, { ...HEAD, 'content-type': 'text/html; charset=utf-8', 'content-security-policy': CSP }).end(html);
      return;
    }

    // --- A filtered, paged list, without building the desk (E1.3, ----
    // 2026-09-27). See `src/pages.mjs` (header comment) for the full
    // contract and `docs/dashboard-entries-list.md` for the operational
    // write-up.
    //
    //   ok/warning  -> 200 (warning still carries a page)
    //   unknown     -> 400 (the FILTER itself names something unknown)
    //   error       -> 500 (a broken cursor, or the search index for
    //                  `q` could not be built)
    if (url.pathname === '/entries.json') {
      const found = pages.page(root, {
        type: url.searchParams.get('type') || null,
        project: url.searchParams.get('project') || null,
        q: url.searchParams.get('q') || '',
        after: url.searchParams.get('after') || null,
        n: url.searchParams.get('n') || undefined,
      });
      const code = { ok: 200, warning: 200, unknown: 400, error: 500 }[found.state];
      if (!code) throw new Error(`pages.page() answered an unknown state '${found.state}'`);
      res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(found));
      return;
    }

    // --- Tasks: long CLI work with progress/result/cancel (E1.7, -----
    // 2026-09-27). See `src/tasks.mjs` (header comment) for the full
    // contract, and `docs/dashboard-tasks.md` for the operational
    // write-up. English mirror of lucky-mem's `/vorgang` family.
    //
    // A task is a child process of an EXISTING CLI command
    // (`src/tasks.mjs`, `KINDS`) — no second export/verify code path.
    // `/task.json` only reads. `/task` and `/task/cancel` write (start
    // or end a child process) and sit behind the SAME check `/setting`
    // uses — `writegate.refusal()`: the write switch (off by default,
    // since 2026-09-27), then readonly, Host and Origin.
    if (url.pathname === '/task.json') {
      const id = url.searchParams.get('id');
      if (id) {
        const found = tasks.read(root, id);
        // cat-confirm-cm: a finished task has written (confirm a project, a category ...), and the stamp
        // does not see every place — the stored dashboard counts as stale from here, once per task.
        if (found.running === false && !taskEndSeen.has(id)) {
          taskEndSeen.add(id);
          if (taskEndSeen.size > 500) taskEndSeen.delete(taskEndSeen.values().next().value);
          dashCache.invalidate();
        }
        const code = { ok: 200, warning: 200, unknown: 404, error: 500 }[found.state] ?? 500;
        res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify(found));
        return;
      }
      const kinds = {};
      for (const [key, spec] of Object.entries(tasks.KINDS)) {
        kinds[key] = { title: spec.title, description: spec.description, resume: spec.resume };
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify({ state: 'ok', kinds, running: tasks.overview(root) }));
      return;
    }

    if (url.pathname === '/task' || url.pathname === '/task/cancel') {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      // The write switch, then readonly, Host, Origin — all in ONE
      // function (`src/writegate.mjs`), shared by every writing route.
      const no = writegate.refusal(root, cfg, req);
      if (no) { short(res, no.code, no.text); return; }
      // F21: one bounded body reader (src/body-reader.mjs); the cap counts BYTES incl. the current chunk.
      // A reason and a path are the largest parameters; 16 KB, URL-encoded.
      readBoundedBody(req, res, 16384, (read) => {
        if (read.status === BODY_ABORTED) return; // client gone: no answer, no mutation
        const tooBig = read.status === BODY_TOO_BIG;
        const body = read.body ?? '';
        if (tooBig) { short(res, 413, 'Too much.'); return; }
        const form = new URLSearchParams(body);
        const kind = form.get('kind') ?? '';
        // No-JS forms send `from=/` (the old desk did; a bookmarked or
        // hand-written form still may): they get a 303 back to `/` on success and a
        // short HTML page on refusal — never raw JSON in a browser tab.
        // A CLOSED list, like `/setting`'s: any other `from` is ignored
        // and the JSON contract below stays exactly as it was.
        const page = form.get('from') === '/';
        const answer = (code, json) => {
          if (!page) {
            res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
              .end(JSON.stringify(json));
          } else if (code < 300) {
            res.writeHead(303, { location: '/' }).end();
          } else {
            short(res, code, json.reason || json.state);
          }
        };
        if (url.pathname === '/task') {
          // Everything but `kind` and `from` is a PARAMETER of the kind;
          // `tasks.start` checks it against the kind's own closed list
          // (an empty field counts as not given — a form sends hidden,
          // empty fields too).
          const params = {};
          for (const [k, v] of form) if (k !== 'kind' && k !== 'from' && v !== '') params[k] = v;
          let began;
          try {
            began = tasks.start(root, kind, params, { user: personSignedIn(req) });
          } catch (e) {
            if (e?.code === 'INVALID_PARAMS') {
              answer(400, { state: 'error', reason: e.message });
              return;
            }
            if (e?.code === 'UNKNOWN_KIND') {
              answer(400, { state: 'unknown', reason: e.message, known: Object.keys(tasks.KINDS) });
              return;
            }
            if (e?.code === 'NOT_A_PERSON') {
              answer(403, { state: 'error', reason: e.message });
              return;
            }
            if (e?.code === 'LOCK_ACTIVE') {
              answer(409, { state: 'warning', reason: e.message, runningId: e.runningId });
              return;
            }
            answer(500, { state: 'error', reason: e?.message || String(e) });
            return;
          }
          answer(201, { state: 'ok', ...began });
          return;
        }
        // /task/cancel
        tasks.cancel(root, kind).then((result) => {
          answer(200, { state: 'ok', ...result });
        }).catch((e) => {
          if (e?.code === 'UNKNOWN_KIND') {
            answer(400, { state: 'unknown', reason: e.message, known: Object.keys(tasks.KINDS) });
            return;
          }
          if (e?.code === 'NOTHING_ACTIVE') {
            answer(409, { state: 'warning', reason: e.message });
            return;
          }
          answer(500, { state: 'error', reason: e?.message || String(e) });
        });
      });
      return;
    }

    // --- The desk -----------------------------------------------------
    // No fallback on purpose. If the data cannot be collected the answer
    // is a 500 that names the reason — never a page that renders
    // something else and keeps the heading. That is the failure mode the
    // arriving UI export shipped with, and the whole point of building
    // this one the other way round.
    //
    // **`/desk.json`, not `/dashboard.json` (2026-09-28, English name
    // since 2026-10-01).** The desk's
    // numbers used to answer at `/dashboard.json`. The new dashboard
    // (lucky-mem's Dashboard-Muster-3, ported) owns `/dashboard` and
    // `/dashboard.json` in both houses, so the old route was renamed
    // BEFORE the new page was built — never two meanings for one address,
    // not even for one commit (owner decision 2026-09-28, port spec §6.2).
    if (url.pathname === '/desk.json') {
      let data;
      try { data = dashboard.collect(root, { env, cfg }); } catch (e) {
        res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
          .end(`desk data could not be collected: ${e?.message || e}`);
        return;
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(data));
      return;
    }

    // --- The German aliases: a redirect to the English path ------------
    // cheap-mem is English throughout (owner decision 2026-09-26). The
    // page and the desk data were reachable at `/pult` and `/pult.json`
    // until 2026-10-01; a bookmark or a script that still uses them is
    // sent on with 308 (method and body kept), query string included, so
    // nothing that worked before stops working.
    if (url.pathname === '/pult' || url.pathname === '/pult.json') {
      const to = url.pathname === '/pult' ? dashboardPage.PATHS.page : '/desk.json';
      res.writeHead(308, { location: `${to}${url.search}` }).end();
      return;
    }

    // --- The old pages: a redirect into the dashboard -------------------
    // `/console` and `/viewer` were pages of their own until 2026-09-28.
    // Their features live in the dashboard now (settings, knowledge); a
    // bookmark lands on the matching view instead of a 404.
    if (url.pathname === '/console' || url.pathname === '/viewer') {
      res.writeHead(303, { location: url.pathname === '/console' ? '/#settings/system' : '/#knowledge/entries' }).end();
      return;
    }
    res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }).end('not found');
  }
  // board-tempo-cm: a large store has no synchronous build and no stored
  // head yet -> start the first (background) build when the server starts,
  // not when the first person opens the page. A small store builds
  // synchronously on its first request as before (no work at start).
  handler.warm = () => {
    const b = dashboardCache.storeBytes(root, { env })?.build ?? null;
    if (b !== null && b <= dashboardCache.SYNC_UP_TO_BYTES) return;
    try { dashCache.get(); } catch { /* the first request says it */ }
  };
  return handler;
}

/**
 * @param opts.allowWrites true = writing on for THIS run
 *   (`mem serve --allow-writes`). Deliberately not an environment
 *   variable: an exported variable outlives the run it was meant for,
 *   and the switch then has a third, invisible home.
 * @param opts.measure true = keep the weekly measurement series
 *   (src/measurements.mjs) while running; `mem serve` sets it.
 */
export function serve(root, env = process.env, { allowWrites = false, measure: measureWeekly = false, recall = false } = {}) {
  const cfg = { ...readConfig(env), allowWrites: allowWrites === true };
  const allowed = bindAllowed(cfg);
  if (!allowed.ok) throw new Error(allowed.reason);
  // No password yet: keep a setup code ONLY on this machine and say in
  // the log WHERE it is — never the code itself.
  if (cfg.login) {
    try {
      const e = login.ensureSetupCode(login.dirFor(root, env));
      if (e.needed) process.stderr.write(`serve: no password set. The setup code is in ${e.file} (mem serve setup-code)\n`);
    } catch (e) {
      process.stderr.write(`serve: setup code could not be created: ${e?.message || e}\n`);
    }
  }
  const handler = buildHandler(root, cfg, env);
  const server = http.createServer(handler);
  // The weekly measurement series (src/measurements.mjs): one line per
  // ISO week, written by THIS process on its own clock — never by a page
  // read. `unref` so a measurement timer never keeps a stopped server alive.
  // Only a REAL server measures (`mem serve`, or this file run
  // directly): a probe that starts a server to test a route must not
  // find a measurement line appearing in its fixture memory.
  const measure = () => { measurements.recordIfDue(root); };
  let timer = null;
  if (measureWeekly) {
    timer = setInterval(measure, 6 * 60 * 60 * 1000);
    timer.unref?.();
    server.on('close', () => clearInterval(timer));
  }
  return new Promise((resolve) => {
    server.listen(cfg.port, cfg.host, () => {
      // W1 parity: a start marker so `doctor.checkRunningCode` can tell
      // whether this process still runs the code it started with.
      // Never fatal — a marker that cannot be written degrades to
      // UNKNOWN on the doctor side, not a server that refuses to start.
      try { runningmark.writeMarker(root, { service: 'serve', codePath: PACKAGE_ROOT }); }
      catch (e) { process.stderr.write(`serve: could not write the W1 start marker: ${e?.message || e}\n`); }
      if (measureWeekly) setImmediate(measure);
      setImmediate(() => handler.warm());
      // M10: the warm recall server (src/recallserver.mjs), a child process,
      // a Unix socket under .pipeline/recall/. Only a REAL server starts
      // it (`mem serve`, `recall: true`) — the same rule as `measure`: a
      // probe that starts this server to test a route must not find a
      // socket appearing in its fixture memory. MEM_RECALL_SERVER=0 turns
      // it off. A failed start leaves the console running; the hook then
      // simply finds no socket and runs direct.
      if (recall && env.MEM_RECALL_SERVER !== '0') {
        // As a child process under a keeper (M10 follow-up): after a code
        // change it restarts itself with a fresh import.
        import('../src/recallserver-keeper.mjs')
          .then((k) => { const kept = k.keep(root, { env }); server.once('close', () => { kept.stop(); }); })
          .catch((e) => process.stderr.write(`serve: recall server not started: ${e?.message || e}\n`));
      }
      resolve({ server, cfg });
    });
  });
}

// Started directly rather than imported: run it.
if (process.argv[1] && path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url))) {
  const root = process.env.CHEAP_MEM_ROOT || process.cwd();
  const flags = process.argv.slice(2);
  serve(root, process.env, { allowWrites: flags.includes('--allow-writes'), measure: true, recall: true }).then(({ server, cfg }) => {
    const bound = server.address();
    process.stderr.write(
      `cheap-mem console on http://${cfg.host}:${bound.port}/ `
      + `(root ${root}, ${cfg.token ? 'token set' : 'localhost only'}`
      + `, writing ${writegate.read(root, gateOpts(cfg)).state})\n`);
  }).catch((e) => {
    process.stderr.write(`${e.message}\n`);
    process.exit(1);
  });
}
