#!/usr/bin/env node
// mem-serve — the console and the viewer at one fixed link.
//
// `mem viewer` writes a ONE-OFF HTML file: a photograph, thrown away
// when it goes stale. That is deliberately not a server. This is the
// other mode: one link that always shows the current state, and the
// only place in this project where anything can be SET without a
// shell.
//
// The trade is worth naming out loud. The viewer file was "no daemon,
// nothing that keeps running". This IS a daemon. So it carries the two
// properties the file had, and one more, because a link is reachable
// from outside:
//
//  1. It renders only through `viewer.build()` and `console.collect()`,
//     which read the redacted drawers — never `raw/`. No un-redacted
//     capture material leaves the process.
//  2. It never writes the rendered content to disk, commits nothing,
//     publishes nothing. The HTML lives in RAM and goes to the browser
//     that asked.
//  3. Fail-closed on auth: with no CHEAP_MEM_SERVE_TOKEN it serves
//     localhost ONLY. Binding to a public address without a token is
//     REFUSED — the process does not start.
//
// The intended shape: bind to 127.0.0.1, put a tunnel or reverse proxy
// in front, and let that (or the token) be the door.

import http from 'node:http';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import * as viewer from '../src/viewer.mjs';
import * as consolePage from '../src/console.mjs';
import * as dashboard from '../src/dashboard.mjs';
import * as astra from '../src/astra.mjs';
import * as webauth from '../src/webauth.mjs';
import * as pages from '../src/pages.mjs';
import * as tasks from '../src/tasks.mjs';
import * as writegate from '../src/writegate.mjs';

export function readConfig(env = process.env) {
  return {
    token: env.CHEAP_MEM_SERVE_TOKEN || '',
    host: env.CHEAP_MEM_SERVE_HOST || '127.0.0.1',
    port: Number(env.CHEAP_MEM_SERVE_PORT || 8847),
    title: env.CHEAP_MEM_SERVE_TITLE || 'cheap-mem',
    // **Writing is OFF by default** (decision 2026-09-27, reversing the
    // earlier "on by default"): an open-source dashboard writes nothing
    // before its owner allows it. The switch is `dashboard.allowWrites`
    // in `.mem/config.json`, or `allowWrites` below for one run
    // (`mem serve --allow-writes`); see `src/writegate.mjs`. READONLY is
    // the older, stricter latch and still wins over both.
    readonly: env.CHEAP_MEM_SERVE_READONLY === '1',
    allowWrites: false,
    hosts: String(env.CHEAP_MEM_SERVE_HOSTS ?? '')
      .split(',').map((x) => x.trim()).filter(Boolean),
    origins: String(env.CHEAP_MEM_SERVE_ORIGINS ?? '')
      .split(',').map((x) => x.trim()).filter(Boolean),
  };
}

export function bindAllowed({ host, token }) {
  return webauth.bindAllowed({ host, token, variable: 'CHEAP_MEM_SERVE_TOKEN' });
}

/** Token from query, cookie or bearer — in that order. */
function tokenFrom(req, url) {
  const q = url.searchParams.get('k');
  if (q) return q;
  const bearer = webauth.bearerFrom(req);
  if (bearer) return bearer;
  const cookie = req.headers.cookie || '';
  const m = /(?:^|;\s*)mem_k=([^;]+)/.exec(cookie);
  return m ? decodeURIComponent(m[1]) : '';
}

/**
 * Every path this server answers. A list, not a rule, so a new path is a
 * decision that shows up in a diff.
 *
 * **Exported deliberately.** The auth probe in `test/console.test.mjs`
 * used to carry its own hand-typed copy of three of these, and when
 * `/pult` and `/dashboard.json` were added on 2026-09-16 the probe went
 * on passing while saying nothing about them — a guarantee that covers
 * a list nobody keeps in step is the defect this project keeps meeting.
 * The probe now reads THIS list, so a sixth path is covered the moment
 * it is added.
 */
export const PATHS = Object.freeze([
  '/', '/console', '/viewer', '/setting', '/console.json', '/pult', '/dashboard.json',
  '/entry.json', '/entries.json', '/task', '/task.json', '/task/cancel',
]);

/**
 * The paths that WRITE. Every one of them runs `writegate.refusal()`
 * first; the probes read this list, so a fourth writing route is
 * covered the moment it is named here.
 */
export const WRITE_PATHS = Object.freeze(['/setting', '/task', '/task/cancel']);

/** The server config, as `writegate.read()` takes it. */
export function gateOpts(cfg) {
  return { flag: cfg.allowWrites === true, readonly: cfg.readonly === true };
}

/** The headers every content response carries. Once, not three times. */
const HEAD = Object.freeze({
  'cache-control': 'no-store',
  // The content is private: no referrer, no framing, no sniffing.
  'referrer-policy': 'no-referrer',
  'x-content-type-options': 'nosniff',
  'x-frame-options': 'DENY',
});

function short(res, code, text) {
  res.writeHead(code, { ...HEAD, 'content-type': 'text/html; charset=utf-8' })
    .end(`<!doctype html><meta charset="utf-8"><title>console</title>`
      + `<body style="font:16px/1.5 system-ui;padding:1rem">`
      + `<p><b>Not set.</b></p><p>${String(text).replace(/[<&]/g, '')}</p>`
      + `<p><a href="/">back to the console</a></p>`);
}

/**
 * @param env the environment `cfg` was BUILT from — not `process.env`.
 * The sibling project shipped that mistake: the page then reports
 * connections belonging to a different server than the one serving it.
 */
export function buildHandler(root, cfg, env = process.env) {
  return function handler(req, res) {
    let url;
    try { url = new URL(req.url, 'http://x'); }
    catch { res.writeHead(400).end('bad request'); return; }

    // Health: no auth, so a tunnel or a supervisor can check without
    // knowing the token. It reveals nothing about the content.
    if (url.pathname === '/health') {
      res.writeHead(200, { 'content-type': 'text/plain; charset=utf-8' }).end('ok');
      return;
    }

    if (!PATHS.includes(url.pathname)) {
      res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }).end('not found');
      return;
    }

    // Destructured rather than read as a property of `cfg`: the secret
    // latch flags a property read off a config object ON PURPOSE — such
    // an object really can hold an inlined literal — and the right
    // answer to a rule one disagrees with is not to loosen it.
    const { token } = cfg;
    const decision = webauth.authDecision({
      token,
      given: tokenFrom(req, url),
      remoteLoopback: webauth.remoteIsLoopback(req),
    });
    if (!decision.allowed) {
      // **Invisible principle**: no valid token gets EXACTLY the answer
      // an unknown path gets — a bare 404. No "token required", no
      // product name, no 401 that would reveal something guarded is
      // here. A scanner sees "nothing".
      res.writeHead(404, { 'content-type': 'text/plain; charset=utf-8' }).end('not found');
      return;
    }

    // Token arrived as ?k= → set it as a cookie and redirect without the
    // query, so the secret leaves the address bar and the history.
    // SameSite=Lax, not Strict: the path may lead through an identity
    // provider and back, which is a cross-site top-level navigation.
    if (decision.setCookie && url.searchParams.get('k')) {
      res.writeHead(302, {
        'set-cookie': `mem_k=${encodeURIComponent(url.searchParams.get('k'))}`
          + '; Path=/; Max-Age=34560000; HttpOnly; Secure; SameSite=Lax',
        location: '/console',
      }).end();
      return;
    }

    // --- Writing paths -------------------------------------------------
    //
    // Exactly three, and each one starts with `writegate.refusal()`:
    //   POST /setting      set one knob from console.SETTINGS
    //   POST /task         start a long CLI job as a child process
    //   POST /task/cancel  end one
    // Every other path only reads. `WRITE_PATHS` below is the list the
    // probes check against; a fourth writing route belongs in it.

    // --- Setting --------------------------------------------------------
    if (url.pathname === '/setting') {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      // The write switch, then readonly, Host, Origin — all in ONE
      // function (`src/writegate.mjs`), shared by every writing route.
      const no = writegate.refusal(root, cfg, req);
      if (no) { short(res, no.code, no.text); return; }
      let body = '';
      let tooBig = false;
      req.on('data', (chunk) => {
        // A cap, so a form cannot fill the process. Two named fields do
        // not need a kilobyte.
        if (body.length > 8192) { tooBig = true; return; }
        body += chunk;
      });
      req.on('end', () => {
        if (tooBig) { short(res, 413, 'Too much.'); return; }
        const p = new URLSearchParams(body);
        try {
          consolePage.apply(root, p.get('id') ?? '', p.get('value') ?? '', { by: 'console' });
        } catch (e) {
          short(res, 400, e?.message || String(e));
          return;
        }
        // Redirect after writing, rather than rendering: otherwise a
        // reload applies the same change again.
        // Back to the page the form was on. A CLOSED list, not the
        // submitted value: an open redirect target is how a form field
        // becomes a way to send someone somewhere else.
        const back = p.get('from') === '/' ? '/' : '/console';
        res.writeHead(303, { location: back }).end();
      });
      return;
    }

    // --- The console --------------------------------------------------
    //
    // It used to live at `/`. The desk took that place on 2026-09-16;
    // the console kept everything it could do and moved one door along.
    // `/console.json` answers unchanged — probes and the setup check
    // read it, and changing a shape while changing a look turns two
    // separable mistakes into one indistinguishable one.
    if (url.pathname === '/console' || url.pathname === '/console.json') {
      let data;
      try { data = consolePage.collect(root, { env, cfg }); }
      catch (e) {
        res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
          .end(`console could not be built: ${e?.message || e}`);
        return;
      }
      if (url.pathname === '/console.json') {
        res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify(data));
        return;
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'text/html; charset=utf-8' })
        .end(consolePage.asHtml(data, { writable: data.writes.allowed }));
      return;
    }

    // --- One entry, without building the desk (D1, 2026-09-27) -------
    //
    // Until this route existed, the only way to look up ONE entry over
    // this server was `/dashboard.json`, which builds every view,
    // every drawer, every project — to hand back one row. This route
    // resolves the id directly through `dashboard.getEntryFast()` (see
    // its header comment in `src/dashboard.mjs` for the full contract
    // and the one search it deliberately skips); it never touches
    // `dashboard.collect()` or `astra.build()`.
    //
    // Same four states dashboard.getEntryFast() returns, mapped to
    // HTTP the same way lucky-mem's `/eintrag.json` mirror maps
    // zustand:gut/unbekannt/fehler/warnung — 'ok'/'warning' both answer
    // 200 (found, one of them with a disclosed gap), 'unknown' answers
    // 404, 'error' answers 500. No fallback: a state this route does
    // not recognise is a bug in `getEntryFast()`, not something to
    // paper over here.
    if (url.pathname === '/entry.json') {
      const id = url.searchParams.get('id') || '';
      let found;
      try { found = dashboard.getEntryFast(root, id); } catch (e) {
        res.writeHead(500, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify({ state: 'error', id, reason: e?.message || String(e) }));
        return;
      }
      const code = { ok: 200, warning: 200, unknown: 404, error: 500 }[found.state];
      if (!code) throw new Error(`getEntryFast() answered an unknown state '${found.state}'`);
      res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(found));
      return;
    }

    // --- A filtered, paged list, without building the desk (E1.3, ----
    // 2026-09-27). See `src/pages.mjs` (header comment) for the full
    // contract and `docs/dashboard-entries-list.md` for the operational
    // write-up.
    //
    //   ok/warning  -> 200 (warning still carries a page)
    //   unknown     -> 400 (the FILTER itself names something unknown)
    //   error       -> 500 (a broken cursor, or the search index for
    //                  `q` could not be built)
    if (url.pathname === '/entries.json') {
      const found = pages.page(root, {
        type: url.searchParams.get('type') || null,
        project: url.searchParams.get('project') || null,
        q: url.searchParams.get('q') || '',
        after: url.searchParams.get('after') || null,
        n: url.searchParams.get('n') || undefined,
      });
      const code = { ok: 200, warning: 200, unknown: 400, error: 500 }[found.state];
      if (!code) throw new Error(`pages.page() answered an unknown state '${found.state}'`);
      res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify(found));
      return;
    }

    // --- Tasks: long CLI work with progress/result/cancel (E1.7, -----
    // 2026-09-27). See `src/tasks.mjs` (header comment) for the full
    // contract, and `docs/dashboard-tasks.md` for the operational
    // write-up. English mirror of lucky-mem's `/vorgang` family.
    //
    // A task is a child process of an EXISTING CLI command
    // (`src/tasks.mjs`, `KINDS`) — no second export/verify code path.
    // `/task.json` only reads. `/task` and `/task/cancel` write (start
    // or end a child process) and sit behind the SAME check `/setting`
    // uses — `writegate.refusal()`: the write switch (off by default,
    // since 2026-09-27), then readonly, Host and Origin.
    if (url.pathname === '/task.json') {
      const id = url.searchParams.get('id');
      if (id) {
        const found = tasks.read(root, id);
        const code = { ok: 200, warning: 200, unknown: 404, error: 500 }[found.state] ?? 500;
        res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify(found));
        return;
      }
      const kinds = {};
      for (const [key, spec] of Object.entries(tasks.KINDS)) {
        kinds[key] = { title: spec.title, description: spec.description, resume: spec.resume };
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
        .end(JSON.stringify({ state: 'ok', kinds, running: tasks.overview(root) }));
      return;
    }

    if (url.pathname === '/task' || url.pathname === '/task/cancel') {
      if (req.method !== 'POST') {
        res.writeHead(405, { allow: 'POST', 'content-type': 'text/plain; charset=utf-8' })
          .end('POST only');
        return;
      }
      // The write switch, then readonly, Host, Origin — all in ONE
      // function (`src/writegate.mjs`), shared by every writing route.
      const no = writegate.refusal(root, cfg, req);
      if (no) { short(res, no.code, no.text); return; }
      let body = '';
      let tooBig = false;
      req.on('data', (chunk) => {
        if (body.length > 4096) { tooBig = true; return; }
        body += chunk;
      });
      req.on('end', () => {
        if (tooBig) { short(res, 413, 'Too much.'); return; }
        const form = new URLSearchParams(body);
        const kind = form.get('kind') ?? '';
        // The desk's own no-JS forms (`src/astra/tasks.mjs`) send
        // `from=/`: they get a 303 back to the desk on success and a
        // short HTML page on refusal — never raw JSON in a browser tab.
        // A CLOSED list, like `/setting`'s: any other `from` is ignored
        // and the JSON contract below stays exactly as it was.
        const page = form.get('from') === '/';
        const answer = (code, json) => {
          if (!page) {
            res.writeHead(code, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
              .end(JSON.stringify(json));
          } else if (code < 300) {
            res.writeHead(303, { location: '/' }).end();
          } else {
            short(res, code, json.reason || json.state);
          }
        };
        if (url.pathname === '/task') {
          let began;
          try {
            began = tasks.start(root, kind);
          } catch (e) {
            if (e?.code === 'UNKNOWN_KIND') {
              answer(400, { state: 'unknown', reason: e.message, known: Object.keys(tasks.KINDS) });
              return;
            }
            if (e?.code === 'LOCK_ACTIVE') {
              answer(409, { state: 'warning', reason: e.message, runningId: e.runningId });
              return;
            }
            answer(500, { state: 'error', reason: e?.message || String(e) });
            return;
          }
          answer(201, { state: 'ok', ...began });
          return;
        }
        // /task/cancel
        tasks.cancel(root, kind).then((result) => {
          answer(200, { state: 'ok', ...result });
        }).catch((e) => {
          if (e?.code === 'UNKNOWN_KIND') {
            answer(400, { state: 'unknown', reason: e.message, known: Object.keys(tasks.KINDS) });
            return;
          }
          if (e?.code === 'NOTHING_ACTIVE') {
            answer(409, { state: 'warning', reason: e.message });
            return;
          }
          answer(500, { state: 'error', reason: e?.message || String(e) });
        });
      });
      return;
    }

    // --- The desk -----------------------------------------------------
    // No fallback on purpose. If the data cannot be collected the answer
    // is a 500 that names the reason — never a page that renders
    // something else and keeps the heading. That is the failure mode the
    // arriving UI export shipped with, and the whole point of building
    // this one the other way round.
    // `/pult` still answers beside `/` so a bookmark from before the
    // move keeps working.
    if (url.pathname === '/' || url.pathname === '/pult' || url.pathname === '/dashboard.json') {
      let built;
      try {
        built = url.pathname === '/dashboard.json'
          ? { data: dashboard.collect(root, { env, cfg }) }
          : astra.build(root, { title: cfg.title, env, cfg, writable: writegate.read(root, gateOpts(cfg)).allowed });
      } catch (e) {
        res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
          .end(`desk could not be built: ${e?.message || e}`);
        return;
      }
      if (url.pathname === '/dashboard.json') {
        res.writeHead(200, { ...HEAD, 'content-type': 'application/json; charset=utf-8' })
          .end(JSON.stringify(built.data));
        return;
      }
      res.writeHead(200, { ...HEAD, 'content-type': 'text/html; charset=utf-8' })
        .end(consolePage.insertNav(built.html, 'desk'));
      return;
    }

    // --- The viewer ---------------------------------------------------
    let html;
    try {
      ({ html } = viewer.build(root, { title: cfg.title }));
      html = consolePage.insertNav(html, 'viewer');
    } catch (e) {
      res.writeHead(500, { 'content-type': 'text/plain; charset=utf-8' })
        .end(`viewer could not be built: ${e?.message || e}`);
      return;
    }
    res.writeHead(200, { ...HEAD, 'content-type': 'text/html; charset=utf-8' }).end(html);
  };
}

/**
 * @param opts.allowWrites true = writing on for THIS run
 *   (`mem serve --allow-writes`). Deliberately not an environment
 *   variable: an exported variable outlives the run it was meant for,
 *   and the switch then has a third, invisible home.
 */
export function serve(root, env = process.env, { allowWrites = false } = {}) {
  const cfg = { ...readConfig(env), allowWrites: allowWrites === true };
  const allowed = bindAllowed(cfg);
  if (!allowed.ok) throw new Error(allowed.reason);
  const server = http.createServer(buildHandler(root, cfg, env));
  return new Promise((resolve) => {
    server.listen(cfg.port, cfg.host, () => resolve({ server, cfg }));
  });
}

// Started directly rather than imported: run it.
if (process.argv[1] && path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url))) {
  const root = process.env.CHEAP_MEM_ROOT || process.cwd();
  const flags = process.argv.slice(2);
  serve(root, process.env, { allowWrites: flags.includes('--allow-writes') }).then(({ server, cfg }) => {
    const bound = server.address();
    process.stderr.write(
      `cheap-mem console on http://${cfg.host}:${bound.port}/ `
      + `(root ${root}, ${cfg.token ? 'token set' : 'localhost only'}`
      + `, writing ${writegate.read(root, gateOpts(cfg)).state})\n`);
  }).catch((e) => {
    process.stderr.write(`${e.message}\n`);
    process.exit(1);
  });
}
