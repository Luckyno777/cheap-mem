async function handleCall(name, args) {
  const root = resolveRoot();
  const cfg = cfgmod.readConfig(root);

  switch (name) {
    case 'mem_log': {
      const { type, project = null, tags, ...fields } = args;
      const data = { ...fields };
      if (Array.isArray(tags)) data.tags = tags;
      const { path: p, entry } = memory.logEntry(root, type, data, { project });
      return textResult(
        `Appended: ${path.relative(root, p)}\n  id: ${entry.id}\n  ts: ${entry.ts}\n\n` +
        `Deliver with: git -C ${root} add . && git -C ${root} commit -m 'log ${type}: ...' && git -C ${root} push`);
    }
    case 'mem_links': {
      const g = memory.linksOf(root, args.id);
      const zeilen = [];
      zeilen.push(g.entry ? `${g.entry._type}  ${shortLine(g.entry)}` : `(no entry with id ${g.id})`);
      const zeig = (r, pfeil) => `    ${pfeil} ${String(r.kind).padEnd(12)} ${r.other}  `
        + (r.entry ? `${r.entry._type}: ${shortLine(r.entry)}` : '(missing entry)');
      if (g.out.length) { zeilen.push('', '  this entry ->'); for (const r of g.out) zeilen.push(zeig(r, '->')); }
      if (g.incoming.length) { zeilen.push('', '  -> this entry'); for (const r of g.incoming) zeilen.push(zeig(r, '<-')); }
      if (!g.out.length && !g.incoming.length) zeilen.push('', '  no links yet.');
      return textResult(zeilen.join('\n'));
    }
    case 'mem_show': {
      const e = memory.entriesById(root).get(args.id);
      if (!e) return textResult(`No entry with id ${args.id}.`);
      return textResult(JSON.stringify(e, null, 2));
    }
    case 'mem_experiences': {
      const xs = memory.experiences(root, {
        minCited: args.min_cited ?? 0, type: args.type ?? 'learning',
      });
      if (!xs.length) return textResult('No experiences recorded yet.');
      return textResult(xs.map((e) => `${e.id}  cited ${e.cited}`
        + `${e.contested ? '  [CONTESTED]' : ''}  ${shortLine(e)}`).join('\n'));
    }
    case 'mem_topics': {
      const key = args.key ?? null;
      const xs = memory.topicEntries(root, key);
      if (!key) {
        // Ohne Schluessel: welche Themen gibt es ueberhaupt. Ein Agent,
        // der die Namen nicht kennt, kann nach keinem fragen.
        const zaehl = new Map();
        for (const e of xs) zaehl.set(e._topic, (zaehl.get(e._topic) ?? 0) + 1);
        if (!zaehl.size) return textResult('No topics yet.');
        return textResult([...zaehl.entries()].sort((a, b) => b[1] - a[1])
          .map(([t, n]) => `${String(n).padStart(4)}  ${t}`).join('\n'));
      }
      if (!xs.length) return textResult(`Nothing under topic '${key}'.`);
      return textResult(xs.map((e) => `${String(e.ts ?? '').slice(0, 10)}  `
        + `${e._type.padEnd(10)} ${e.id ?? ''}  ${shortLine(e)}`).join('\n'));
    }
    case 'mem_facts': {
      const fs2 = memory.currentFacts(root, { staleDays: args.stale_days ?? 120 });
      if (!fs2.length) return textResult('No tracked facts yet (log them as type timeline with --key).');
      return textResult(fs2.map((f) => {
        const c = f.current ?? {};
        const seit = String(c.valid_from ?? c.ts ?? '').slice(0, 10);
        return `${f.key}  =  ${c.value ?? shortLine(c)}   (as of ${seit}`
          + `${f.stale ? ', STALE' : ''}${f.history?.length ? `, ${f.history.length} older` : ''})`;
      }).join('\n'));
    }
    case 'mem_explain': {
      const cap = args.project
        ? capability.grantProject(args.project, { subject: 'mcp' })
        : capability.grantAll('mcp');
      const r = retrieval.explainMissing(root, args.query, cap, args.id);
      return textResult(JSON.stringify(r, null, 2));
    }
    case 'mem_retrieve': {
      const { query, project, type, top, as_of: asOf, with_disputed: withDisputed } = args;
      if (!query) return textResult('mem_retrieve needs a query.');
      // The session's capability. Narrow when a project is named, and the
      // everything-capability otherwise -- an MCP session speaks for the
      // owner of the memory it was pointed at. Minting it HERE rather than
      // taking a scope argument is the point: there is no request shape
      // that widens what this session may reach.
      const cap = project
        ? capability.grantProject(project, { subject: 'mcp' })
        : capability.grantAll('mcp');
      const r = retrieval.retrieve(root, query, cap, {
        top: top ?? 10, asOf: asOf ?? null, type: type ?? null,
        withDisputed: Boolean(withDisputed),
      });
      const lines = r.claims.length
        ? r.claims.map((c) => `${c.id}  [${c.authority}${c.author ? '/' + c.author : ''}]  `
            + `${c.scope}  ${c.ts ?? '?'}  ${c.score.toFixed(2)}\n  `
            + `${c.body.replace(/\s+/g, ' ').slice(0, 300)}`)
        : [`No claims for '${r.query}' within ${r.scopes.join(' ') || '(no scope)'}.`];
      if (r.excluded.length) {
        lines.push('', `excluded: ${r.excluded.length}`);
        for (const e of r.excluded.slice(0, 10)) lines.push(`  ${e.id ?? '-'}: ${e.why}`);
      }
      return structuredResult(r, lines);
    }

    case 'mem_find': {
      const { query, pattern, type, project, since, top, literal } = args;
      const q = query ?? pattern;   // `pattern` kept for older callers
      if (!q) return textResult('mem_find needs a query.');
      const s = since ? sinceOf(since) : null;

      if (literal) {
        const types = type ? [type] : Object.keys(memory.TYPES);
        const projects = project ? [project === 'global' ? null : project] : null;
        const hits = memory.find(root, q, { types, projects, since: s });
        if (!hits.length) return textResult(`No literal hits for '${q}'.`);
        return textResult(hits.slice(0, 50).map((h) =>
          `${h._source}:${h._line}  [${h.ts ?? '?'}]  ${shortLine(h)}`).join('\n'));
      }

      const cfg = (() => { try { return cfgmod.readConfig(root); } catch { return { language: 'en' }; } })();
      thesaurus.loadUserGroups(root, fs, path);
      const index = search.loadIndex(root, { language: cfg.language });
      const ranked = search.search(index, q, {
        top: top ?? 10, type: type ?? null, project: project ?? null,
        since: s, language: cfg.language,
      });
      if (!ranked.length) {
        return textResult(`No hits for '${q}' (${index.N} entries). Try literal:true.`);
      }
      return textResult(ranked.map((h) => {
        const mark = h.raw ? (h.pending ? '  [raw, not yet digested]' : '  [raw]') : '';
        const preview = h.raw
          ? (raw.snippet(root, h.source, q) || String(h.entry.text ?? '').slice(0, 200))
          : shortLine(h.entry);
        return `${h.source}:${h.line}  [${h.entry.ts ?? '?'}]  ${h.score.toFixed(2)}${mark}\n`
          + `  ${String(preview).replace(/\s+/g, ' ').slice(0, 200)}`;
      }).join('\n'));
    }

    case 'mem_duties': {
      const { open, done } = memory.openDuties(root,
        { project: args.project === undefined ? undefined : args.project });
      if (!open.length) return textResult(`Nothing open (${done.length} closed).`);
      return textResult([`${open.length} open:`, ...open.map((d) =>
        `  [${d.id}] ${d.owner ? `@${d.owner} ` : ''}${d.title ?? d.text ?? '?'}  (since ${d.ts})`)]
        .join('\n'));
    }

    case 'mem_duty_close': {
      const { entry } = memory.closeDuty(root, args.id, {
        state: args.state ?? memory.DUTY_STATE.DONE,
        why: args.why ?? null,
        project: args.project ?? null,
      });
      return textResult(`Closed ${args.id} (${entry.state}). New line: ${entry.id}`);
    }

    case 'mem_context': {
      const n = Number(args?.n ?? 20);
      return textResult(memory.context(root, { n }));
    }
    case 'mem_inbox_new': {
      const to = args?.to ?? inbox.whoAmI(root);
      if (!to) throw new Error("no 'to' and whoami not set");
      const { new: fresh, known } = inbox.newFor(root, cfg.participants, { to });
      if (!args?.no_mark && fresh.length) {
        inbox.markSeen(root, { to, names: fresh.map((m) => m.name) });
      }
      if (!fresh.length) return textResult(`Nothing new for '${to}'. ${known} known.`);
      return textResult(
        `${fresh.length} new for '${to}': (${known} known)\n` +
        fresh.map((m) => `  [${m.state}] ${m.name}\n         ${m.subject} (from ${m.from})`).join('\n'));
    }
    case 'mem_inbox_show': {
      // Through inbox.readMessage, which guards the name. This used to
      // join args.name onto the inbox directory itself, so a client
      // could ask for '../../../../etc/passwd' and get it back as tool
      // output — while setState, right next to it, had the guard.
      return textResult(inbox.readMessage(root, args.name));
    }
    case 'mem_inbox_write': {
      const from = args.from ?? inbox.whoAmI(root);
      if (!from) throw new Error("no 'from' and whoami not set");
      const { path: p } = inbox.write(root, cfg.participants, {
        from, to: args.to, subject: args.subject, text: args.text,
      });
      return textResult(
        `Written: ${path.relative(root, p)}\n\n` +
        `Deliver with: git -C ${root} add . && git -C ${root} commit -m 'inbox: ${args.subject}' && git -C ${root} push`);
    }
    case 'mem_inbox_ack': {
      const m = inbox.setState(root, cfg.participants, args.name, args.state);
      return textResult(`${args.name}: state -> ${m.state}`);
    }
    case 'mem_project_init': {
      const { dir, created, existed } = memory.projectInit(root, args.name, { title: args.title ?? null });
      return textResult(
        `Project: ${path.relative(root, dir)}\n` +
        (created.length ? `  created: ${created.join(', ')}\n` : '') +
        (existed.length ? `  existed: ${existed.join(', ')}\n` : ''));
    }
    default:
      throw new Error(`Unknown tool: ${name}`);
  }
}

function sinceOf(s) {
  const m = /^(\d+)([dhm])$/.exec(s);
  if (m) {
    const [, n, unit] = m;
    const ms = { d: 86400000, h: 3600000, m: 60000 }[unit] * Number(n);
    return new Date(Date.now() - ms);
  }
  return new Date(s);
}

function shortLine(e) {
  const parts = [];
  if (e.class) parts.push(`[${e.class}]`);
  if (e.topic) parts.push(`[${e.topic}]`);
  if (e.title) parts.push(e.title);
  if (e.choice) parts.push(`→ ${e.choice}`);
  if (e.text) parts.push(String(e.text).slice(0, 80).replace(/\s+/g, ' '));
  return parts.join(' — ') || '(no summary)';
}

/**
 * The house rules served as MCP `instructions`, or undefined.
 *
 * This is the only channel through which a connected agent hears
 * anything from us before it acts for the first time. Without it an
 * agent has `mem_log` and never calls it — measured on 2026-09-07:
 * twelve tool calls in one task, every one a read, zero writes all day.
 *
 * The file's preamble (everything up to the first `---` line) explains
 * why it exists and does NOT go out: it is written for us, and every
 * line costs tokens on every connection.
 *
 * If the file is missing the server does NOT fail. A server without
 * house rules is worse but usable; a server that won't start over a
 * missing text file is not. Anything OTHER than "not found" is thrown —
 * the first version swallowed everything here and hid a missing import,
 * so `instructions` came out empty with nothing pointing at a fault.
 */
function houseRules(fs) {
  try {
    const raw = fs.readFileSync(path.join(PKG_ROOT, 'HOUSE-RULES.md'), 'utf8');
    const at = raw.indexOf('\n---\n');
    const body = (at >= 0 ? raw.slice(at + 5) : raw).trim();
    return body || undefined;
  } catch (e) {
    if (e.code === 'ENOENT') return undefined;
    throw e;
  }
}

async function main() {
  const fs = await import('node:fs');
  const pkg = JSON.parse(fs.readFileSync(path.join(PKG_ROOT, 'package.json'), 'utf8'));

  const server = new Server(
    { name: 'cheap-mem', version: pkg.version },
    { capabilities: { tools: {} }, instructions: houseRules(fs) },
  );

  server.setRequestHandler(ListToolsRequestSchema, async () => ({ tools: TOOLS }));
  server.setRequestHandler(CallToolRequestSchema, async (req) => {
    try {
      return await handleCall(req.params.name, req.params.arguments ?? {});
    } catch (e) {
      return {
        content: [{ type: 'text', text: `Error: ${e.message}` }],
        isError: true,
      };
    }
  });

  const transport = new StdioServerTransport();
  await server.connect(transport);
}

main().catch((e) => {
  process.stderr.write(`mem-mcp fatal: ${e.stack || e.message}\n`);
  process.exit(1);
});
