const HERE = path.dirname(fileURLToPath(import.meta.url));
const PKG_ROOT = path.dirname(HERE);

/**
 * Who this bridge writes as.
 *
 * **Not `agentDefault()`.** That falls back to `human:<os user>`, which
 * is true at a shell and a LIE here: a connected model is not the
 * person whose account the server happens to run under. An invented
 * origin looks like evidence, so it is worse than a vague one.
 *
 * `CHEAP_MEM_AGENT` is how a deployment names its connected agent
 * (`chatgpt`, `codex`, `cursor`). Unset, the honest answer is that we
 * only know it came over the bridge.
 */
/**
 * Y4b: the highest tier a bridge caller may assert. The bridge cannot
 * tell a person from the agent driving it — `user` needs a person who
 * said so (the CLI's `--authority user`, or the dashboard behind a
 * password session), never a tool argument. So a claimed tier above
 * `agent` is lowered to `agent` and the demotion recorded in
 * `authority_clamped_from`, exactly as the process ceiling does on the
 * write path (which still applies on top, when lower). A call that names
 * no tier gets the write path's default, like the CLI (O1: one path).
 */
const BRIDGE_MAX_AUTHORITY = 'agent';

function bridgeAuthority(data) {
  if (data.authority === undefined || data.authority === null || String(data.authority).trim() === '') {
    const { authority: _drop, ...rest } = data;
    return rest;
  }
  const c = authority.clampTier(data.authority, BRIDGE_MAX_AUTHORITY);
  return c.clamped ? { ...data, authority: c.tier, authority_clamped_from: c.from } : { ...data, authority: c.tier };
}

function resolveAgent() {
  const set = String(process.env.CHEAP_MEM_AGENT ?? '').trim();
  return set || 'mcp-client';
}

function resolveRoot() {
  if (process.env.CHEAP_MEM_ROOT) return path.resolve(process.env.CHEAP_MEM_ROOT);
  const walked = cfgmod.findRoot(process.cwd());
  if (walked) return walked;
  throw new Error(
    'No memory root found. Set env CHEAP_MEM_ROOT to a directory that has .mem/config.json ' +
    '(create it with `mem init`).');
}

/**
 * W1 parity: a start marker so `doctor.checkRunningCode` can tell
 * whether this bridge still runs the code it started with. Best
 * effort — no CHEAP_MEM_ROOT resolving is not fatal to serving MCP.
 *
 * Defined here, above `handleCall`, on purpose: `test/mcpprofile.test.mjs`
 * walks each `case` body of `handleCall`'s switch from its own start to
 * the NEXT case (or, for the last case, to end of file) to prove no
 * tool listed as reading actually writes. A qualified write call placed
 * anywhere after that switch's last case would be misattributed to
 * whichever tool happens to be listed last — not a bug in that probe,
 * just a boundary it cannot see past. Keeping this call site above the
 * switch keeps it out of every case's slice.
 */
function markRunningIfPossible() {
  try { runningmark.writeMarker(resolveRoot(), { service: 'mcp-http', codePath: PKG_ROOT }); }
  catch (e) { process.stderr.write(`mem-mcp: could not write the W1 start marker: ${e?.message || e}\n`); }
}

// dash-fix3 parity: the client-visibility journal (src/mcpvisibility.mjs).
// The client comes from `server.getClientVersion()` — set by the SDK
// from the `initialize` handshake's `clientInfo`, never from any env
// var this bridge writes UNDER (that would let any connection log
// itself as whichever name it likes). A logging failure must never
// touch a tool call, so this stays its own try/catch, silent.
//
// **Defined here, not inside `createServer()`.** `test/mcpprofile.test.mjs`
// walks the CASE BODY of `handleCall`'s switch to prove no tool listed
// as reading actually writes; its case-body extraction runs from one
// `case 'mem_xxx':` line to the NEXT (or end of file, for the last
// one). A helper placed textually after that last case — even in an
// unrelated function further down — would be swept into it and read as
// part of `mem_user_habits`'s body. Defined up here instead, it plainly
// is not.
function recordVisibility(server, method, tool) {
  try {
    const client = server.getClientVersion()?.name || null;
    if (client) mcpvisibility.record(resolveRoot(), { method, tool, client });
  } catch { /* the journal is an observation, never a gate */ }
}

/**
 * Every text reply leaves through here — one choke point, on purpose.
 *
 * Before this, `bin/mem-mcp` called `bidi.visible()` nowhere at all
 * (measured: the string `bidi` did not occur in the file), while the
 * three other render paths — `compactLine`, `memory.context()`,
 * `browse.fit()` — each called it individually. Latching each of the
 * ~25 branches in `handleCall` by hand would only be as strong as the
 * one a future branch forgets; wrapping the single function every
 * branch already returns through closes all of them at once, the same
 * reasoning `compactLine`'s docstring gives for why IT is one function
 * instead of four copies.
 */
function textResult(text) {
  return { content: [{ type: 'text', text: sanitizeForDisplay(String(text)) }] };
}

/**
 * A structured result.
 *
 * `structuredContent` is the machine-readable half; the text block is a
 * fallback for clients that do not read it. Both are built from the SAME
 * records, and the text block deliberately reads as a table rather than as
 * prose — a memory that writes sentences is a memory that can be made to
 * write a sentence someone else chose.
 *
 * MCP is not a prompt-injection defence on its own: a client can always
 * flatten these fields back into a paragraph. What it does is remove the
 * step where the MEMORY does the flattening, which is the step this side
 * of the boundary controls.
 *
 * **Bidi marking applies to BOTH halves, deliberately, including
 * `structuredContent`.** See the long comment on `sanitizeForDisplay`
 * (`src/cli/display.mjs`) for the reasoning: a field is not exempt from
 * "display" just because it is typed rather than prose — the moment a
 * client (or a foreign agent reading this JSON directly, which is
 * exactly who this tool is for) turns `claims[].body` into a paragraph
 * or feeds it into a model's context, an unmarked U+202E does the same
 * damage it would have done in the text half. Object KEYS are left
 * alone (`sanitizeForDisplay` only touches string values) — they are
 * this package's own field names, never attacker-controlled.
 */
function structuredResult(data, lines) {
  return {
    content: [{ type: 'text', text: sanitizeForDisplay(lines.join('\n')) }],
    structuredContent: sanitizeForDisplay(data),
  };
}

