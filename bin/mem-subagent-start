#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Lucky H.
# SPDX-License-Identifier: MIT
# mem-subagent-start — SubagentStart hook.
#
# A subagent is its own thread: it never saw whatever SessionStart or
# UserPromptSubmit showed its parent, and it gets neither event itself
# (see src/gauges.mjs). Left alone it starts knowing nothing this
# memory holds — including any procedure a human wrote specifically for
# how an agent assignment is supposed to run (src/procedure.mjs,
# `forSubagentStart`, tag `subagent-start`). This hook is what puts that
# in front of the subagent before its first task.
#
# No model, no network: the tag lookup and the context recap
# (src/subagentstart.mjs) are both deterministic reads over the memory's
# own JSONL logs. Always exits 0 — a hook that starts a subagent must
# never be the reason it fails to start.

set -u

entrutscht() { printf '%s' "${1//\\//}"; }
[ "${MEM_HOOK_OFF:-}" = "1" ] && exit 0
[ "${MEM_SUBAGENT_START_OFF:-}" = "1" ] && exit 0

PROBE="${MEM_STOP_ROOTS:-$HOME/cheap-mem /work/cheap-mem /home/user/cheap-mem}"

ROOT=""
# shellcheck disable=SC2086
for k in "${CHEAP_MEM_ROOT:-}" $PROBE; do
  [ -z "$k" ] && continue
  k="$(entrutscht "$k")"
  [ -f "$k/.mem/config.json" ] && { ROOT="$k"; break; }
done
[ -z "$ROOT" ] && exit 0

# Two shapes, same as mem-before-edit: the memory carries the module
# itself, or a separate code checkout does (CHEAP_MEM_CODE, set by the
# installer for exactly this case).
MODULE=""
if   [ -f "$ROOT/src/subagentstart.mjs" ]; then MODULE="$ROOT/src/subagentstart.mjs"
elif [ -n "${CHEAP_MEM_CODE:-}" ] && [ -f "$CHEAP_MEM_CODE/src/subagentstart.mjs" ]; then
  MODULE="$CHEAP_MEM_CODE/src/subagentstart.mjs"
else
  HERE="$(cd "$(dirname "$(entrutscht "$0")")" && pwd)"
  [ -f "$HERE/../src/subagentstart.mjs" ] && MODULE="$HERE/../src/subagentstart.mjs"
fi
[ -z "$MODULE" ] && exit 0

# The stdin JSON carries session_id etc., but nothing here is keyed on
# it (the block is the same for every subagent) — it is only read so a
# malformed or absent stdin cannot make the module import fail.
if [ ! -t 0 ]; then cat >/dev/null 2>&1 || true; fi

# An ESM specifier is a URL, not a path — the same trap mem-before-edit
# already carries a long note about. On Linux a plain absolute path
# happens to also be a valid specifier, but this same script runs under
# Git Bash on Windows too, where the path is `D:/a/...` and Node reads
# `D:` as a URL SCHEME (ERR_UNSUPPORTED_ESM_URL_SCHEME). `cygpath -m`
# gives the forward-slash form that survives unescaped in the URL; a
# leading slash needs only the `file://` prefix, anything else (a
# drive letter) needs a third slash.
MODULE_FS="$MODULE"
command -v cygpath >/dev/null 2>&1 && MODULE_FS="$(cygpath -m "$MODULE")"
case "$MODULE_FS" in
  /*) MODULE_URL="file://$MODULE_FS" ;;
  *)  MODULE_URL="file:///$MODULE_FS" ;;
esac

CHEAP_MEM_ROOT="$ROOT" node -e '
  import(process.argv[1]).then((m) => {
    const r = m.hookResult(process.env.CHEAP_MEM_ROOT);
    if (r) process.stdout.write(JSON.stringify(r));
  }).catch(() => {});
' "$MODULE_URL" 2>/dev/null

exit 0
