#!/usr/bin/env bash
# mem-digest — lane 2: the one model call.
#
# Runs on a timer. Checks whether the pile is ripe, and if so makes
# EXACTLY ONE model call that sorts the raw material into drawers.
#
# **This is the only model call in the memory loop.** Capturing (the
# Stop hook) and searching (`mem find`) run without one.
#
# Required:
#   CHEAP_MEM_ROOT       absolute path to the memory
#
# Optional:
#   MEM_DIGEST_MAX_BYTES  most raw material per run (default 2000000)
#   MEM_DIGEST_VOLUME_NOW_KB  dueness threshold: volume that is due at once
#   MEM_DIGEST_VOLUME_MIN_KB  dueness threshold: below this, never
#   MEM_DIGEST_QUIET_MIN      dueness threshold: quiet minutes
#   MEM_DIGEST_CEILING_H      dueness threshold: ceiling in hours
#   MEM_DIGEST_STALE_MIN      age at which a lock left by a crashed run
#                             counts as stale (default 120; only used
#                             where there is no flock, e.g. macOS)
#                         the rest stays pending for the next tick
#   MEM_DIGEST_TIMEOUT    seconds for the model call (default 600)
#   MEM_DIGEST_CMD        model CLI (default: claude -p)
#   MEM_DIGEST_PROBE      seconds for the start probe (default 30) — see
#                         mem_start_command in bin/_portable.sh
#   MEM_DIGEST_LOG        log file (default: $ROOT/.mem/digest.log)
#
# Exit codes:
#   0  ran, or nothing to do
#   1  the model call failed, or did nothing
#   2  configuration error

set -u

if [ -z "${CHEAP_MEM_ROOT:-}" ]; then
  echo "error: CHEAP_MEM_ROOT is not set" >&2
  exit 2
fi
ROOT="$CHEAP_MEM_ROOT"
[ -d "$ROOT/.mem" ] || { echo "error: '$ROOT' has no .mem — run mem init" >&2; exit 2; }

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MEM="$HERE/mem"
# shellcheck source=bin/_portable.sh
. "$HERE/_portable.sh"
TIMEOUT="${MEM_DIGEST_TIMEOUT:-600}"
CMD="${MEM_DIGEST_CMD:-claude -p}"
LOG="${MEM_DIGEST_LOG:-$ROOT/.mem/digest.log}"
MAX_BYTES="${MEM_DIGEST_MAX_BYTES:-2000000}"

# Authority ceiling for everything this run writes.
#
# The digest is the ONE place a model writes claims into the log, and until
# 2026-09-05 it had no ceiling: `authority` was whatever the model emitted.
# That composes badly with injection — text inside a captured transcript
# steers what the digest produces — so a sentence in someone else's
# document could mint a `user`-tier claim and overrule everything.
#
# A model's output is an inference over other claims, which is precisely
# what `inferred` means. Set here rather than requested in the prompt: an
# instruction is a request, and the process being constrained is exactly
# the one that may have been told otherwise. src/memory.mjs enforces it
# and records any demotion in `authority_clamped_from`.
export CHEAP_MEM_MAX_AUTHORITY="${CHEAP_MEM_MAX_AUTHORITY:-inferred}"
mkdir -p "$(dirname "$LOG")"

note() { echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] $*" | tee -a "$LOG"; }

# --- Check dueness BEFORE taking the lock ---------------------------
#
# The tick runs often. In the normal case it must be back out within
# milliseconds and with no side effect — no lock, no git, no model.
# Only a ripe pile goes further.
#
# Exit codes of `mem digest due`: 0 no, 1 yes, 3 cannot tell.
#
# The thresholds are settable so that a TEST can establish dueness
# instead of borrowing it. Without this, a probe that wants to measure
# "with work due, exactly one model call" depends on how much raw
# material the working copy happens to carry that hour — red below the
# volume threshold, green above it, with no code change in between.
# That is a flickering probe, and a red that goes away by itself teaches
# people to stop reading red. (Measured in the sibling memory on
# 2026-09-17: the same unchanged CI step was red at 441 KB and green at
# 780 KB, 45 minutes apart.)
DUE_ARGS=""
[ -n "${MEM_DIGEST_VOLUME_NOW_KB:-}" ] && DUE_ARGS="$DUE_ARGS --volume-now $MEM_DIGEST_VOLUME_NOW_KB"
[ -n "${MEM_DIGEST_VOLUME_MIN_KB:-}" ] && DUE_ARGS="$DUE_ARGS --volume-min $MEM_DIGEST_VOLUME_MIN_KB"
[ -n "${MEM_DIGEST_QUIET_MIN:-}" ]     && DUE_ARGS="$DUE_ARGS --quiet $MEM_DIGEST_QUIET_MIN"
[ -n "${MEM_DIGEST_CEILING_H:-}" ]     && DUE_ARGS="$DUE_ARGS --ceiling $MEM_DIGEST_CEILING_H"
# DUE_ARGS is built here and word splitting is wanted.
#
# The reason goes on its OWN line, not behind the directive: written as
# `disable=SC2086 -- reason`, shellcheck cannot parse the line at all
# (SC1072/SC1073, both at error level) and a suppression that trips the
# checker does not suppress — it aborts it.
# shellcheck disable=SC2086
STATE="$(node "$MEM" --root "$ROOT" digest due $DUE_ARGS 2>>"$LOG")"
case $? in
  0) exit 0 ;;
  1) : ;;
  3) note "cannot tell whether due: $STATE"; exit 1 ;;
  *) note "unexpected exit from the dueness check"; exit 1 ;;
esac

note "due: $STATE"

LOCK="$ROOT/.mem/digest.lock"
LOCKDIR="$ROOT/.mem/digest.lock.d"

# **`flock` does not exist on macOS (measured 2026-09-17).** This used
# to be a bare `flock -n 9`, and a missing flock makes that `if` true —
# so every tick on every Mac reported "already running, skipping" and
# returned 0. The digest has NEVER run there, silently, and the exit
# code said everything was fine.
#
# Class `drei-zustaende-nie-zwei`: "locked", "free" and "cannot tell"
# were folded into two, and the third was read as the first.
#
# Found by the CI step that comes with this change, on its first run.
# No test had ever started this script.
#
# The fallback is `mkdir`, atomic on POSIX — exactly one caller wins,
# the same guarantee flock gives here. A directory left by a crashed
# run is recognised by its age, otherwise one crash would block the
# digest forever (the trap the PowerShell port already names for its
# PID file).
STALE_MIN="${MEM_DIGEST_STALE_MIN:-120}"

# `capped` and `mem_take_lock` come from bin/_portable.sh (sourced above).


# Never two digests at once. The subshell isolates the file descriptor:
# without the parentheses FD 9 stays open in the parent process and the
# lock is never released.
(
  if ! mem_take_lock "$LOCK" "$LOCKDIR" "$STALE_MIN"; then
    note "already running, skipping"
    exit 0
  fi

  PENDING_JSON="$(node "$MEM" --root "$ROOT" raw pending --json 2>>"$LOG")"
  if [ -z "$PENDING_JSON" ]; then
    note "could not read the pending state"
    exit 1
  fi

  # Only hand one run as much material as a session can actually read.
  # A week of backlog can be megabytes; without a cap the session
  # suffocates on context and reports nothing useful. The rest simply
  # stays pending and the next tick takes it, so a backlog drains over
  # several runs instead of failing in one.
  SELECTION="$(printf '%s' "$PENDING_JSON" | MAX="$MAX_BYTES" ROOT="$ROOT" node -e '
    const fs=require("fs"), path=require("path");
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
      let o;try{o=JSON.parse(d)}catch{process.exit(1)}
      const max=Number(process.env.MAX), root=process.env.ROOT;
      if(!root){process.stderr.write("selection: ROOT missing\n");process.exit(2)}
      // A file whose size we cannot read counts as LARGE. The other way
      // round (unknown = 0) lets a silent stat error eat the whole cap:
      // the sum never grows, everything is selected, and the limit is
      // useless without anyone noticing.
      // Smallest first, so one huge capture that no session can finish
      // does not block everything behind it forever.
      const sized=(o.open||[]).map(f=>{
        let s=Infinity;
        try{s=fs.statSync(path.join(root,f)).size}
        catch(e){process.stderr.write("selection: "+f+" unreadable\n")}
        return {f,s};
      }).sort((a,b)=>a.s-b.s);
      const chosen=[];let sum=0;
      for(const {f,s} of sized){
        if(chosen.length && sum+s>max) break;
        chosen.push(f);sum+=s;
        if(sum>=max) break;
      }
      console.log(JSON.stringify({chosen,sum,total:(o.open||[]).length}));
    })' 2>>"$LOG")"

  CHOSEN="$(printf '%s' "$SELECTION" | node -e '
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
      try{for(const f of JSON.parse(d).chosen)console.log(f)}catch{}})')"
  if [ -z "$CHOSEN" ]; then
    note "nothing selected — nothing to do"
    exit 0
  fi
  N_CHOSEN="$(printf '%s\n' "$CHOSEN" | grep -c .)"
  N_TOTAL="$(printf '%s' "$SELECTION" | node -e '
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
      try{process.stdout.write(String(JSON.parse(d).total))}catch{process.stdout.write("?")}})')"
  [ "$N_CHOSEN" != "$N_TOTAL" ] && \
    note "backlog: $N_CHOSEN of $N_TOTAL captures this run, rest next tick"

  PROMPT="You are the digest for a cheap-mem memory. Read \$ROOT/DIGEST.md first and follow it.

Root: $ROOT
CLI:  node $MEM --root $ROOT <command>

Raw material for THIS run (only these, no more):
$(printf '%s' "$CHOSEN" | sed 's/^/  /')

Work like this:
1. Read each capture: mem raw show <path>
   Do NOT read a large capture in one go. Get the header first
   (--head reports __lines), then read in windows:
     mem raw show <path> --from 0 --count 400
     mem raw show <path> --from 400 --count 400
   Write down what you learned after each window instead of holding it
   all in your head. If a capture is too large to finish: do NOT mark
   it digested, write what you have, and log an error with
   --class digest-overflow.
2. Before writing anything, check for duplicates:
     mem find \"<keyword>\" --since 7d
3. Sort into drawers, every entry WITH --origin AND --asked:
     mem log <type> --title ... --text ... --tags ... \\
       --asked '<3-5 words someone would ASK with>' \\
       --origin '{\"raw\":\"<path>\",\"session_id\":\"<id>\"}'
   --asked is the one place you add words that are NOT in the entry.
   Ask yourself: months from now, in what words would someone come
   looking for this — not knowing the words it is written in? Those.
   Rules: at most five; a word already in the entry does not count and
   must be left out; no invented facts, only other words for the same
   thing. If nothing genuinely different comes to mind, leave it off —
   an empty field is honest, a padded one is noise in every future
   search.
4. Close any duty that is now fulfilled (mem duties lists them)
5. Synthesise — ONLY when a pattern is genuinely there (usually none):
   If, across the entries you just wrote and ones you find with
   'mem find', a clear recurring pattern stands out that is NOT already
   captured as a learning, you may add AT MOST TWO learning entries that
   name it. Each MUST cite the real entries it draws from:
     mem log learning --title ... --text ... \\
       --origin '{\"derived_from\":[\"<id>\",\"<id>\"]}'
   Rules that do not bend: only from entries you actually read or found;
   never invent a link, a cause, or a fact; if nothing clearly recurs,
   add NONE. This is the one step that truly needs a model — keep it rare
   and honest, or skip it.
6. Mark as digested: mem raw digested <path1> <path2> ...
7. Commit and push.

Three to ten sorted entries is normal, plus at most two synthesised
learnings and only when warranted. More than fifteen means you are not
condensing enough. Stop after the push."

  # Remember how much was pending. The model call's exit code alone
  # says NOTHING about whether work happened — a session that fails on
  # permissions explains itself at length and exits 0. That is exactly
  # what happened on the first real run: "done" reported, nothing done.
  BEFORE="$(node "$MEM" --root "$ROOT" raw pending --json 2>/dev/null | node -e '
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
      try{process.stdout.write(String((JSON.parse(d).open||[]).length))}
      catch{process.stdout.write("-1")}})')"

  # MEM_HEADLESS stops this call from triggering the Stop hook — the
  # digest would otherwise capture itself.
  #
  # **`timeout` is not on macOS either (measured 2026-09-17).** This line
  # used to call it unconditionally, so on a Mac the model call died with
  # 127 before it started and the tick reported "model call exited 127
  # (timeout or error)". Together with the missing `flock` above that
  # means the digest could not work on macOS by two independent routes.
  #
  # bin/mem-retrieve learned this months ago and says so in its own
  # comment: "A hard dependency on it made the whole hook silently
  # produce nothing on macOS." The lesson was written down once and
  # never carried over here, because nothing ever ran this script. Same
  # shape as the flock hole, one layer down.
  #
  # So: whichever exists, and when neither does, run the command
  # directly. Losing the cap is worse than nothing only if a hung model
  # can block something — the tick is a timer job, and the next tick
  # stands down on the lock.
  # How the CLI is started is decided ONCE, here, not per tick — see
  # mem_start_command in bin/_portable.sh for why the detour exists and
  # why only 126 triggers it. The reason is logged either way: a detour
  # that stays silent is exactly the line missing next time someone
  # goes looking.
  mem_start_command "$CMD" "${MEM_DIGEST_PROBE:-30}"
  note "start command: $MEM_START_REASON"

  ( cd "$ROOT" && MEM_HEADLESS=digest capped "$TIMEOUT" "${MEM_START[@]}" "$PROMPT" ) >>"$LOG" 2>&1
  MODEL_EXIT=$?

  # **124, 126 and 127 are three specific sentences, not one.** Folding
  # them into "timeout or error" cost the sister house a whole night on
  # 2026-09-18: the log said `Permission denied` on one line and
  # `exit=126 (timeout or error)` on the next, and whoever read only
  # the second went looking for a time cap that did not exist.
  if [ "$MODEL_EXIT" -ne 0 ]; then
    case "$MODEL_EXIT" in
      124)
        note "model call exited 124 — TIME CAP expired, and only that"
        note "  Raise MEM_DIGEST_TIMEOUT (currently ${TIMEOUT}s) or look at why the run is slow."
        ;;
      126)
        note "model call exited 126 — FOUND, BUT NOT EXECUTABLE"
        note "  Not a timeout. The file is there but may not start: either the"
        note "  x-bit is missing, or it sits on a mount flagged noexec."
        note "  Look: command -v ${CMD%% *}; ls -l \"\$(command -v ${CMD%% *})\""
        note "  The interpreter detour was probed at start and did not help:"
        note "  $MEM_START_REASON"
        ;;
      127)
        note "model call exited 127 — NOT FOUND"
        note "  Not a time cap but a PATH: '${CMD%% *}' is not on it."
        note "  Look: echo \"\$PATH\"; command -v ${CMD%% *}"
        ;;
      *)
        note "model call exited $MODEL_EXIT (error)"
        ;;
    esac
    exit 1
  fi

  # **Check the effect, do not trust the exit code.** If not a single
  # capture was marked digested, the digest did nothing — whatever it
  # claims. A silent failure reported as success is worse than a loud
  # error.
  AFTER="$(node "$MEM" --root "$ROOT" raw pending --json 2>/dev/null | node -e '
    let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
      try{process.stdout.write(String((JSON.parse(d).open||[]).length))}
      catch{process.stdout.write("-1")}})')"

  if [ "$BEFORE" = "-1" ] || [ "$AFTER" = "-1" ]; then
    note "effect not measurable (raw pending unreadable) — treating as failure"
    exit 1
  fi

  if [ "$AFTER" -ge "$BEFORE" ]; then
    note "FAILED: the model call exited 0 but digested nothing ($BEFORE -> $AFTER)."
    note "  Most common cause: the session was not allowed to run 'node bin/mem'."
    note "  Check the permissions of your assistant's headless mode."
    note "  The end of $LOG shows what the session reported."
    exit 1
  fi

  note "done — $((BEFORE - AFTER)) captures digested"
  exit 0
)
exit $?
