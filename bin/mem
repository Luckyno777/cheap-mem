#!/usr/bin/env node
/**
 * mem — cheap-mem CLI entry point.
 *
 * Subcommands:
 *   init                     one-time setup (creates .mem/config.json + skel)
 *   log <type> --<field> ... append a JSONL entry
 *   find "<pattern>"         search across log files
 *   context [--n N]          compact dump for session start
 *   project init <name>      idempotent project skeleton
 *   project new|confirm|suggestions   a NEW project, with a similarity guard
 *   category list|assign|confirm|open|create|acknowledge|rename|merge|initial-assign   categories above topics
 *   inbox write|new|show|ack     inbox operations (was: post)
 *   inbox watch              remote-only "post ready" check, exit 0/1/3
 *   whoami / whoami <name>   who this install is in the channel
 *   correction <type> <old-id> --<field> ...
 */

import { parseArgs, out, die, guardOutputFor } from '../src/cli/shell.mjs';
import { groupOf } from '../src/cli/command-index.mjs';

// Blocking writes on stdout/stderr. A child started from Node (execFile,
// spawn) gets a socket, not a pipe; under load its buffer fills, the rest
// of the output waits in a queue, and a process.exit() right after
// out() cuts it off — measured 2026-09-29: 46 of 150 help runs truncated,
// with this line 0 of 150. One line here covers every exit path.
for (const s of [process.stdout, process.stderr]) s._handle?.setBlocking?.(true);

/**
 * The six groups, each loaded ONLY when its command runs.
 *
 * **Why not a static import of all six.** A start compiled the code of all
 * 87 handlers to run one (cli-speed-cm, TB4: the module compile, not the
 * work, is where a start goes). `src/cli/command-index.mjs` says which
 * group holds a command; only that group is imported. The loaders are
 * written out as literal specifiers, not built from the group name, so
 * every import stays greppable and checkable (test/cli-groups.test.mjs).
 * The duplicate refusal of the old merge now sits in that index, and
 * `test/cli-lazy-groups.test.mjs` holds index and tables equal.
 */
const LOAD_GROUP = {
  write: () => import('../src/cli/commands/write.mjs'),
  search: () => import('../src/cli/commands/search.mjs'),
  capture: () => import('../src/cli/commands/capture.mjs'),
  agents: () => import('../src/cli/commands/agents.mjs'),
  setup: () => import('../src/cli/commands/setup.mjs'),
  admin: () => import('../src/cli/commands/admin.mjs'),
};

// Pre-scan for a leading --root <path>, so it can appear before the subcommand.
// Named argv, not `raw` — that name belongs to the raw-capture module.
let argv = process.argv.slice(2);
if (argv[0] === '--root' && argv[1] && !argv[1].startsWith('--')) {
  process.env.CHEAP_MEM_ROOT = argv[1];
  argv = argv.slice(2);
}
const [head, ...rest] = argv;
const { args, rest: leftover } = parseArgs(rest);

if (!head || head === '--help' || head === '-h' || head === 'help') {
  // Only the type list below needs the memory module; it is loaded here, not for every start.
  const memory = await import('../src/memory.mjs');
  out("mem — cheap-mem CLI");
  out("");
  out("Setup:");
  out("  init [--participants a,b,c] [--branch main] [--remote origin]");
  out("  setup <agent> [--dry-run]             wire it into an agent (claude)");
  out("  whoami [<name>]                       who this install is (or set)");
  out("");
  out("Memory (append-only logs):");
  out("  log <type>       [--project X] --<field> <value> ...");
  out(`                    types: ${Object.keys(memory.TYPES).join(', ')}`);
  out('  find "<query>"   [--type T] [--project P|global] [--since 7d|24h|ISO]');
  out("                    ranked, no model. --literal for substring, --fresh to rebuild");
  out("                    retired (done/discarded/superseded) hidden; --with-retired shows them");
  out("  discard <id> / supersede <old> --by <new>  retire a discarded thought / one replaced by an entry already written");
  out("  done <id>        [--why \"...\"]        retire a finished entry");
  out("  restore <id>     [--why \"...\"]        take a closed entry up again (new line)");
  out("  merge <id> <id>..  [--title T] [--text T]  merge entries of one drawer (append-only)");
  out("  find --brief / show <id>       two-stage recall: scan labels, pull one full");
  out("  browse           [--fresh]            interactive: it re-ranks as you type");
  out("  duties           [--all]              what is still owed");
  out("  duties close <id> [--why \"...\"]      append a closing line");
  out("  deadlines        [--json]             open duties with a due date and their state");
  out("  context          [--n 20]");
  out("  facts            [--stale] [--conflicts] [--key k] [--stale-days N]");
  out("                    current value of every fact that changes over time");
  out("  core             [--max 40] [--stale-days N]");
  out("                    always-load block of settled facts (bake-in, no training)");
  out("  topics / topic <key> [--all]          subjects, and where one stands now");
  out("  links <id>                            typed edges in and out of one entry");
  out("  error-fixes backfill [--repo P] [--since REV] [--check-only]");
  out("                    resolves links error <- commit/duty (Fixes: trailer)");
  out("  workflow new|check|list|show          named sequences, with triggers/patterns");
  out("  command-guard build|show|check|seed   mishandling errors with --command-pattern warn before a matching Bash command");
  out("  snippet new|list|show                 reusable blocks with {{PLACEHOLDERS}}");
  out("  card add|list                         decision cards: question, context, options with effects (mem card --help)");
  out("  experiences      [--all] [--type T]   what the memory stands behind");
  out("                    ranked by citations, not by how often it was read");
  out("  viewer           [--out f.html] [--title \"...\"] [--open]");
  out("                    one self-contained HTML page to browse it all");
  out("  correction <type> <old-id> [--project X] --<field> <value>");
  out("  project init <name> [--title \"...\"]");
  out("  project new <name> --title \"...\" --reason \"...\" [--captures p1,p2]");
  out("  project confirm <name>  |  project suggestions [--json]");
  out("  category list|assign|confirm|open|create|acknowledge|rename|merge|initial-assign");
  out("                    categories above topics; mem category --help");
  out("");
  out("Inbox (cross-session messages):");
  out("  inbox new        [--as N]              what is new for me");
  out("  inbox all        [--as N]              all messages to me");
  out("  inbox write      [--as N] --to N --subject \"...\" [< text.md]");
  out("  inbox show <name> [--as N]");
  out("  inbox ack <name> [state]               state -> replied (default)");
  out("  inbox watch      [--as N] [--branch main] [--remote origin] [--skip-fetch]");
  out("  inbox claim|done|failed|claims <name>  take with expiry / finish / give up / who holds it");
  out("                    Exit code 0/1/3 for shell pollers.");
  out("");
  out("");
  out("Capture, digest, upkeep:");
  out("  raw pending|show <path>|digested <path>...   the captured material");
  out("  raw review [--project X] [--from D] [--to D]  three states: present/deleted/unreachable");
  out("  raw delete <path> --reason .. [--yes]         irreversible; shows first, deletes with --yes");
  out("  digest due|bell                              is the pile ripe? (exit 0/1/3)");
  out("  thesaurus [--graph]                          word groups; --graph = what it learned");
  out("  hooks install|check                          arm and prove the secret check");
  out("  doctor [--quiet] [--alarm]                   is this memory healthy?");
  out("                                               --alarm: only what is DOWN now");
  out("  raw archive [--set <where>] [--list-stores]  where the raw capture lives");
  out("  raw migrate [--remove] / raw export --from --to --into");
  out("");
  out("  user [--json] [--min-evidence N] [--patterns f.json]  generic, code-only");
  out("                    habit meter over YOUR OWN captures (delegated decision,");
  out("                    correction, pasted terminal output, language) --");
  out("                    patterns are a JSON file, no participant names");
  out("  user --self-test / user --session-start (<= 5 lines for a hook)");
  out("");
  out("State at a glance:");
  out("  serve  [--port N] [--readonly] [--allow-writes]  console + viewer at one link");
  out("  board  [--html] [--json] [--days N]          every lane on one screen");
  out("  status [--json]                              installed vs. actually working");
  out("  classes [--open]                             the twelve error classes, and coverage");
  out("  bridge report <short-hash>                   an MCP bridge reports its checkout");
  out("");
  out("Recall, deeper:");
  out("  retrieve \"<question>\" [--as-of ISO] [--json]  claims, each with a coverage line");
  out("  explain \"<question>\" <claim-id>             why one NAMED claim came back, or did not");
  out("  when \"<time expression>\" [--tz Zone]        time-range recall, no model");
  out("  find-hybrid \"<query>\" [--top N]             BM25 and local semantic, fused (RRF)");
  out("  find-embed \"<query>\" [--top N]              local semantic only; else lexical, with a notice");
  out("  embed setup|backfill|status                  the local (ollama) vector store, off by default");
  out("  component <path> [--top 8]                   everything about ONE file, both spellings");
  out("  topic-merge <old>... --to <new>              fold topics; applied on READ, nothing rewritten");
  out("");
  out("Agents, questions, messages:");
  out("  agents                                       who is registered vs. who appears in entries");
  out("  agent new|show <name>                        agents/<name>/ with prompt, knowledge, skills");
  out("  onboarding <agent>                           five checks, each evidenced by an entry");
  out("  questions [new|--all]                        what we do NOT know");
  out("  answer <question-id> --with <entry-id>       closes a question by naming the answer");
  out("  broadcast <error-id> [--dry-run]             tell the agents who touched the same file");
  out("  heartbeat [--what \"...\"] [--gap MIN]         this agent was running and could write");
  out("");
  out("What the memory stands on:");
  out("  procedures [--project X]                     the steps it has recorded");
  out("  teach [--project X]                          what it has to say to a newcomer, five sections");
  out("  sources add|bridge|list                      where a claim came from");
  out("  store put|list|get|verify                    files the memory keeps by hash");
  out("  observations [--last N]                      what it injected, and when (local, never committed)");
  out("");
  out("Calendar (appointments, reminders, planned agent actions):");
  out("  appointment new --at \"tomorrow 9:00\" --title \"...\" [--repeat R] [--remind-before 15m] [--wake A --task \"...\"]");
  out("  appointment list|show|cancel|move|confirm|due|tick|cap|today|calendar   see `mem appointment --help`");
  out("                    a human arms an action with --authority user; agents only propose; the watcher ticks the clock");
  out("");
  out("Health and limits:");
  out("  guard run [--duty]                           every latch: is the error back?");
  out("  guard quote                                  share of errors with a guard, empty test scaffolds");
  out("  guard gaps [--json] [--top N]                which errors WITHOUT a guard first? (ranking, nothing written)");
  out("  gaps [--json] [--top N] | gaps rate [--json]  open/closed knowledge gaps, and the weekly rate");
  out("  suggest procedure <class>                    W11: draft `mem log procedure` for a repeated error class (prints, writes nothing)");
  out("  epoch show|record [--force]                  has the memory gone BACKWARDS here?");
  out("  chain [--json]                               do the per-writer seals still hold?");
  out("  archive [--json]                             what moved out of this clone, still reachable?");
  out("  gauges [--session <id>]                      occupancy, sufficiency, and what they cost");
  out("  asked-learn [--write] [--shown]               learn query words from recall misses");
  out("  rewrites [care [--write]|lock|unlock]        learned rewrite table: question word -> entry word");
  out("  search-levers [--json]                       Block H search levers: which are on, loads after a showing");
  out("  effect [--json]                              share of injections used again, Wilson interval");
  out("  ledger [--json]                              jobs per agent kind/model — counted, not claimed");
  out("  today [--json]                               operations, decisions & facts to verify — one source, three surfaces");
  out("  gold today [--json] [--draw]                 N9 parity: real gold questions to rate today");
  out("  gold rate <id> <verdict> [hit-id]             append one verdict (correct/wrong/empty-correct)");
  out("  gold miss collect|daily|status|score         local, never-committed question text of real misses; scored from 20 cases");
  out("  modelcost [--days N] [--json]                 token/cost journal from a real --output-format json run — estimate, not a bill");
  out("  skills usage [--json]                         W10: skill calls from the raw captures, with coverage (nothing is removed)");
  out("  skills account|sharpen|version              L3: experience account, sharpening package, new version (trial)");
  out("  experience review|guards|effect               L3: fixes to review, test<->error guards, procedure effect (views)");
  out("  shrink [--no-write]                          an append-only memory must not get smaller");
  out("  net [--json]                                 what points at what, from DECLARED links");
  out("  paths [--json]                               do the files named in entries still exist?");
  out("  maintenance dedupe [--dry-run]               merge identical entries, keep the authority");
  out("  raw-capture --transcript <path>              capture one transcript by hand");
  out("  envvars [--json] [--markdown]                every environment variable cheap-mem reads, with default and current value");
  out("  version                                      which cheap-mem this is");
  out("");
  out("Global flags: --root <path>   memory root (else CHEAP_MEM_ROOT or walk cwd)");
  process.exit(0);
}

const group = groupOf(head);
if (!group) die(`Unknown command: '${head}'. Run 'mem' with no args for help.`);
guardOutputFor(head); // the read commands run with the output guard on (src/cli/shell.mjs)
const { COMMANDS } = await LOAD_GROUP[group]();
const cmd = Object.hasOwn(COMMANDS, head) ? COMMANDS[head] : undefined;
if (!cmd) die(`mem ${head}: the command index lists it under '${group}', which does not define it.`);
try {
  await cmd({ rest: leftover, args });
} catch (e) {
  die(`mem ${head}: ${e.message}`);
}
