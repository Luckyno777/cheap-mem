#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Lucky H.
# SPDX-License-Identifier: MIT
# mem-catch-fail — the failure the exit code hid (M19 port from lucky-mem).
#
# PostToolUseFailure only fires when Bash exits nonzero. A command whose
# own OUTPUT says it did not succeed while the shell says otherwise —
# `npm test | tail -20`, `some-check || true`, a TAP/spec run that prints
# `# fail 3` and still exits 0 — runs straight past it, and so does every
# other cheap-mem hook: none of them look at what a successful Bash call
# actually printed.
#
# So this hook hangs on PostToolUse instead, matcher `Bash` ONLY, and
# therefore runs after EVERY successful Bash call in a session — which is
# exactly why the sieve below has to stay cheap: no `node` start unless a
# candidate signature is actually there. Recall itself is unchanged: past
# the sieve, this calls the same `mem find` lane mem-retrieve already
# uses, just triggered by a caught failure instead of a typed message.
#
# Env:
#   CHEAP_MEM_ROOT           absolute path to the memory
#   MEM_CATCH_FAIL_OFF=1     turn this hook off
#   MEM_HOOK_OFF=1           turn ALL cheap-mem hooks off
#   MEM_CATCH_FAIL_TOP       at most this many hits (default 3)
#   MEM_CATCH_FAIL_MIN       minimum BM25 score to show (default 2.0, see below)
#   MEM_CATCH_FAIL_TURNS     where the once-per-session marks live
#   MEM_RETRIEVE_ROOTS       space-separated fallback roots to probe

set -u

entrutscht() { printf '%s' "${1//\\//}"; }
[ "${MEM_CATCH_FAIL_OFF:-}" = "1" ] && exit 0
[ "${MEM_HOOK_OFF:-}" = "1" ] && exit 0

# --- The sieve (pure bash, no process start on the common case) ------
#
# `$(</dev/stdin)` rather than `$(cat)`: no extra process for the case
# that runs after every single successful Bash call. Falls back to
# `cat` when stdin cannot be opened as a path (a socket, seen under some
# spawn setups: ENXIO on /dev/stdin).
{ IN="$(</dev/stdin)"; } 2>/dev/null || IN="$(cat)"
case "$IN" in
  *"not ok"*|*"Error:"*|*"FAIL"*|*"fatal:"*|*"fail "*) ;;
  *) exit 0 ;;
esac
# A line-anchored regex narrows the substring match above before `node`
# ever starts. Deliberately a SUPERSET of the exact check in
# src/errorsignature.mjs (that module decides for real): a false positive
# here costs one extra `node` start, a false negative would lose the
# catch outright. `# fail 0` must not pass: only 1-9 after "fail ".
_start='(\\n|[^\\]")([[:space:]]|\\t)*'
_sig='(not ok|(Uncaught[[:space:]]+)?[A-Za-z]*Error:|FAIL([^A-Za-z0-9_]|$)|fatal:|(#|\\u2139|ℹ)([[:space:]]|\\t)*fail[[:space:]]+0*[1-9])'
[[ "$IN" =~ $_start$_sig ]] || exit 0
unset _start _sig

PROBE="${MEM_RETRIEVE_ROOTS:-$HOME/cheap-mem /work/cheap-mem /home/user/cheap-mem}"
ROOT=""
# shellcheck disable=SC2086
for k in "${CHEAP_MEM_ROOT:-}" $PROBE; do
  [ -z "$k" ] && continue
  k="$(entrutscht "$k")"
  [ -f "$k/.mem/config.json" ] && { ROOT="$k"; break; }
done
[ -z "$ROOT" ] && exit 0

# Two shapes, same as the other hooks: the memory may carry the tool
# itself, or the tool lives in a separate checkout next to this script.
HOOK_DIR="$(cd "$(dirname "$(entrutscht "$0")")" && pwd)"
if [ -f "$ROOT/bin/mem" ]; then
  RUN_MEM=(node "$ROOT/bin/mem")
  TOOL_ROOT="$ROOT"
elif [ -f "$HOOK_DIR/mem" ]; then
  RUN_MEM=(node "$HOOK_DIR/mem" --root "$ROOT")
  TOOL_ROOT="$(dirname "$HOOK_DIR")"
else
  exit 0
fi

# shellcheck source=bin/_portable.sh
. "$HOOK_DIR/_portable.sh"

# --- The exact check + the query to search for (node, past the sieve) -
PARSED="$(printf '%s' "$IN" | MEM_ERRSIG="$TOOL_ROOT/src/errorsignature.mjs" node -e '
  let d = "";
  process.stdin.on("data", (c) => (d += c)).on("end", async () => {
    let j; try { j = JSON.parse(d); } catch { process.exit(0); }
    if (String(j.tool_name ?? "") !== "Bash") process.exit(0);
    let sig;
    try {
      const m = await import(require("node:url").pathToFileURL(process.env.MEM_ERRSIG).href);
      sig = m.errorSignature(m.bashOutput(j.tool_response));
    } catch { process.exit(0); }
    if (!sig) process.exit(0);
    const command = String(j.tool_input?.command ?? "").trim().split(/\s+/)[0] || "";
    const query = command ? `${command} ${sig}` : sig;
    process.stdout.write(JSON.stringify({ sig, query, session: String(j.session_id ?? "") }));
  });' 2>/dev/null)"
[ -z "$PARSED" ] && exit 0

field() { printf '%s' "$PARSED" | node -e "let d=\"\";process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>process.stdout.write(String(JSON.parse(d).$1 ?? \"\")))" 2>/dev/null; }
SIG="$(field sig)"
QUERY="$(field query)"
SESSION="$(field session)"
[ -z "$SIG" ] && exit 0

# --- Once per session per signature, not silently --------------------
#
# Same shape as mem-before-edit's per-file mark, keyed here on session +
# the signature text instead of a path: the SAME caught failure shown
# twice in one session is noise; a DIFFERENT failure (even from the same
# command) is not, so it must still get through.
if [ -n "$SESSION" ]; then
  TURNS="${MEM_CATCH_FAIL_TURNS:-$ROOT/.mem/catch-fail-turns}"
  mkdir -p "$TURNS" 2>/dev/null || true
  find "$TURNS" -maxdepth 1 -mmin +60 -type d -exec rm -rf {} + 2>/dev/null || true
  SAFE="$(printf '%s' "${SESSION}__${SIG}" | cksum | tr -d ' ')"
  mkdir "$TURNS/$SAFE" 2>/dev/null || exit 0
fi

TOP="${MEM_CATCH_FAIL_TOP:-3}"
# --weak: this hook holds its own, lower bar (MEM_CATCH_FAIL_MIN, below);
# `mem find`'s answer gate (search lever h3) is tuned for a spoken question.
HITS="$(capped 5 "${RUN_MEM[@]}" find "$QUERY" --top "$TOP" --json --weak 2>/dev/null)" || exit 0
[ -z "$HITS" ] && exit 0

# **A lower bar than mem-retrieve's (measured against this hook's own
# fixture).** mem-retrieve's MIN=5.0 is tuned for a spoken question
# against short entries; the query here is a whole error-signature block
# (a TAP line, a `# fail N` summary) glued to the command's first word —
# long, and full of words that never appear in a normal entry, which
# drags BM25 scores down for a match that is, in plain terms, exactly
# on topic (an error entry describing the very failure just seen scored
# 3.3 against mem-retrieve's bar of 5.0 in this hook's own test fixture).
# `--top` already caps how many show; this bar only keeps out the
# clearly unrelated, not the merely differently-worded.
#
# **One renderer (Z1c).** The lines come from `recallhook.mjs catch` ->
# `src/recallrender.mjs`, the same code as mem-retrieve: content from
# `retrieval.BODY_FIELDS`, the entry ID, a marked cut, bidi neutralised.
# This hook used to carry its own inline copy of the line builder.
MIN="${MEM_CATCH_FAIL_MIN:-2.0}"
RECALL_JS="$TOOL_ROOT/src/recallhook.mjs"
# The program and the renderer it prints with must both be there: a
# half-updated checkout stays silent instead of printing half a line.
[ -f "$RECALL_JS" ] && [ -f "$TOOL_ROOT/src/recallrender.mjs" ] || exit 0
BLOCK="$(printf '%s' "$HITS" | MEM_RH_MIN="$MIN" node "$RECALL_JS" catch 2>/dev/null)"
[ -z "$BLOCK" ] && exit 0
printf '%s' "$BLOCK"
exit 0
