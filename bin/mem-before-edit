#!/usr/bin/env bash
# mem-before-edit — recall DURING the work, not only on a user's message.
#
# `mem-retrieve` hangs on UserPromptSubmit. It therefore fires exactly
# when the person types something, and stays silent through all the time
# in between — which is when the building actually happens. Errors and
# decisions are not born while reading a question; they are born while
# changing a file.
#
# Measured 2026-09-08 against four defects from one Windows install:
# for THREE of them an entry already existed naming the very file that
# was being touched. None was shown, because between the person's
# message and the write there is no event a hook hangs on.
#
# So: PreToolUse on Edit|Write|NotebookEdit — and Bash when the command
# writes a file (src/bashtargets.mjs) — and the query is the PATH.
#
# --- Why literal and not ranked --------------------------------------
#
# A ranked search on a path ALWAYS returns something: the fragments are
# rare, so the scores are high, even when no entry ever mentioned the
# file. A block that shows up on every edit is skipped after the third
# time — the same lesson mem-retrieve carries as its score bar.
#
# `--literal` is sharper: only entries that really name the path match.
# If none does, nothing is printed. That is the property this can be
# falsified by — for an invented path it MUST stay silent.
#
# --- Two outputs, on purpose -----------------------------------------
#
# `additionalContext` is the documented way to feed text into the turn;
# Claude Code's built-in hook reference lists it generally under
# `hookSpecificOutput` and marks only permissionDecision,
# permissionDecisionReason and updatedInput as "PreToolUse only". That
# it takes effect ON PreToolUse is documented but not measured by us.
# So a `systemMessage` goes out as well — documented for all hooks and
# visible to the person. If one channel is ignored, the hit is still
# seen instead of vanishing quietly.
#
# Env:
#   CHEAP_MEM_ROOT          absolute path to the memory
#   MEM_BEFORE_EDIT_OFF=1   turn this hook off
#   MEM_HOOK_OFF=1          turn ALL cheap-mem hooks off
#   MEM_BEFORE_EDIT_TOP     at most this many hits (default 3)
#   MEM_BEFORE_EDIT_MARKS   where the once-per-file marks live
#   MEM_RETRIEVE_ROOTS      space-separated fallback roots to probe

set -u

# Backslashes become slashes before a path is used as a path.
#
# On Windows every path handed to a hook is native: the memory root,
# and `$0` itself. bash then finds nothing where something is, and the
# hook exits 0 without a word — indistinguishable from "nothing to
# report". Two places per hook needed this, and five hooks carried the
# same copy. Git Bash resolves `C:/…` fine; on Linux and macOS the
# substitution changes nothing.
to_slashes() { printf '%s' "${1//\\//}"; }

# **Which exit did it take?** `MEM_BEFORE_EDIT_TRACE=1` makes every
# early exit name itself on stderr. Nothing is printed without it, and
# stdout is never touched — the hook's contract is unchanged.
#
# This exists because two plausible causes were repaired, both of them
# real bugs verified on Linux, and neither was the reported failure:
# the hook kept exiting 0 in silence on Windows. Guessing a third time
# would cost another round trip. A branch that says its own name costs
# one line.
trace() { [ "${MEM_BEFORE_EDIT_TRACE:-}" = "1" ] && printf 'mem-before-edit: exit at %s\n' "$1" >&2; return 0; }
# The same trace, but for a midpoint state instead of an exit.
# `trace` prints "exit at ..." — at a point that does NOT exit, that
# would be a false statement in its own diagnostic tool.
note() { [ "${MEM_BEFORE_EDIT_TRACE:-}" = "1" ] && printf 'mem-before-edit: %s\n' "$1" >&2; return 0; }
[ "${MEM_BEFORE_EDIT_OFF:-}" = "1" ] && { trace "off-switch"; exit 0; }
[ "${MEM_HOOK_OFF:-}" = "1" ] && { trace "hook-off"; exit 0; }

# Hook time starts here — the journal line carries it (`duration_ms`).
if [ -n "${EPOCHREALTIME:-}" ]; then
  _s="${EPOCHREALTIME%.*}"; _f="${EPOCHREALTIME#*.}"
  MEM_BE_START_MS="${_s}${_f:0:3}"
  unset _s _f
else
  MEM_BE_START_MS="$(( $(date +%s) * 1000 ))"
fi

PROBE="${MEM_RETRIEVE_ROOTS:-${HOME:-}/cheap-mem}"
# D5 (2026-10-14): the roots to try are an ARRAY. This used to be an unquoted
# `$PROBE` in the loop below, so a HOME with a space in it ("/home/Max Muster")
# split the DEFAULT root in two and the hook found no memory - silently, exit 0.
# The documented list stays whitespace-separated; the whole value is tried
# first (it may be ONE path that has a space), then its words. `read -a` does
# not glob, the unquoted expansion did. test/hook-spaces.test.mjs.
PROBE_LIST=()
if [ -n "${MEM_RETRIEVE_ROOTS:-}" ]; then
  PROBE_LIST+=("$MEM_RETRIEVE_ROOTS")
  read -r -a PROBE_WORDS <<< "$MEM_RETRIEVE_ROOTS"
  PROBE_LIST+=(${PROBE_WORDS[@]+"${PROBE_WORDS[@]}"})
elif [ -n "${HOME:-}" ]; then
  PROBE_LIST+=("$HOME/cheap-mem")
fi

# **Backslashes become slashes before anything is looked up.**
#
# On Windows the agent hands this hook a native path —
# `C:\Users\x\AppData\Local\Temp\mem`. bash then tests
# `[ -f "C:\Users\x\.mem/config.json" ]`, finds nothing, and the hook
# exits 0 in silence: no memory, no output, no error. From the outside
# that is indistinguishable from "nothing to say about this file", so
# the hook did nothing on Windows for as long as it has existed and
# nobody could tell.
#
# Reproduced without Windows: the same memory, addressed with slashes,
# answers with 440 characters; addressed with backslashes it answers
# with nothing and exits 0.
#
# Git Bash resolves `C:/Users/...` perfectly well, so one substitution
# is the whole repair. It is a no-op on Linux and macOS, where a
# backslash in a path is a legal character but never a separator in any
# path this hook is handed.

ROOT=""
for k in "${CHEAP_MEM_ROOT:-}" ${PROBE_LIST[@]+"${PROBE_LIST[@]}"}; do
  [ -z "$k" ] && continue
  k="$(to_slashes "$k")"
  [ -f "$k/.mem/config.json" ] && { ROOT="$k"; break; }
done
[ -z "$ROOT" ] && { trace "no-root (CHEAP_MEM_ROOT=${CHEAP_MEM_ROOT:-} PROBE=$PROBE)"; exit 0; }

# Two shapes, same as the other hooks: the memory may carry the tool
# itself, or the tool lives in a separate checkout next to this script.
# `$0` is a path from outside too, and on Windows it carries
# backslashes: `dirname "D:\a\repo\bin\mem-before-edit"` returns `.`,
# so HOOK_DIR became the CURRENT directory instead of bin/. The tool
# next to the hook was then not found and the hook exited 0 in
# silence — the same failure as the root lookup, one line further on.
# Git Bash: `pwd -W` is the Windows form node.exe can open (MSYS2 leaves a path with an apostrophe untranslated; install/claude-code.sh).
HOOK_DIR="$(cd "$(dirname "$(to_slashes "$0")")" && { pwd -W 2>/dev/null || pwd; })"
# **The memory's own bin/ is NOT the default (tool-trust-cm, 2026-10-16).** The
# memory is a git clone that gets pulled from origin; code taken from it is code
# its remote can ship. It is used only when the user switched that on, locally
# (`mem trust-own-tool`, bin/_owntool.sh); otherwise the tool this script sits in.
# shellcheck source=bin/_owntool.sh
if [ -f "$HOOK_DIR/_owntool.sh" ]; then . "$HOOK_DIR/_owntool.sh"; else mem_own_tool_trusted() { return 1; }; fi
if [ -f "$ROOT/bin/mem" ] && mem_own_tool_trusted "$ROOT"; then
  TOOL_ROOT="$ROOT"
elif [ -f "$HOOK_DIR/mem" ]; then
  TOOL_ROOT="$(dirname "$HOOK_DIR")"
else
  trace "no-tool (ROOT=$ROOT HOOK_DIR=$HOOK_DIR)"
  exit 0
fi

# shellcheck source=bin/_portable.sh
. "$HOOK_DIR/_portable.sh"
mem_compile_cache  # R6: V8 compile cache in the user's cache dir, before the first node start

IN="$(cat)"

# --- The journal line (X2b) ----------------------------------------------
#
# Every run that gets as far as a query books ONE line — what it showed, or
# why nothing (the nothing is booked too). Since 2026-10-14 that happens
# INSIDE the single node process (src/beforeedit.mjs). The shell books
# only the one case that process cannot book for itself: it was cut off
# by the time cap below, so the search never answered.
#
#   journal_book <reason|-> <hits> <bytes>
#
# Best-effort and silent: a measurement must not stop what it measures.
journal_book() {
  [ -f "$TOOL_ROOT/src/injection.mjs" ] || return 0
  MEM_J_ROOT="$ROOT" MEM_J_SRC="$TOOL_ROOT/src/injection.mjs" \
    MEM_J_REASON="$1" MEM_J_HITS="$2" MEM_J_BYTES="$3" MEM_J_START="$MEM_BE_START_MS" \
    node -e '
      import(require("node:url").pathToFileURL(process.env.MEM_J_SRC).href).then((m) => {
        const start = Number(process.env.MEM_J_START);
        m.book(process.env.MEM_J_ROOT, {
          occasion: m.OCCASION.BEFORE_EDIT, reason: process.env.MEM_J_REASON === "-" ? null : process.env.MEM_J_REASON,
          bytes: Number(process.env.MEM_J_BYTES), hits: Number(process.env.MEM_J_HITS),
          searched: null, sources: [], ids: [],
          durationMs: Number.isFinite(start) && start > 0 ? Date.now() - start : null,
        });
      }).catch(() => {});' >/dev/null 2>&1 || true
}

# **Bash, too — but only a command that WRITES a file.** `sed -i`,
# `tee`, `> file`, `cp`, `mv` change a file exactly like Edit does, and
# until 2026-10-01 they got no recall at all. Bash fires far more often
# than Edit, so a pure-text prefilter runs FIRST, in bash, before any
# node start: no `>` left after dropping `N>&M` and `>/dev/null`, and no
# tee/sed/cp/mv word anywhere -> silent exit, no journal line. The
# prefilter may be falsely POSITIVE (then src/bashtargets.mjs finds no
# target and the hook exits the same way), never falsely negative for
# a shape the reader knows. Which words count as a written file is
# decided in ONE place, src/bashtargets.mjs — see there for why it
# drops directories, extension-less words and expansions.
IS_BASH=""
if printf '%s' "$IN" | grep -qE '"tool_name"[[:space:]]*:[[:space:]]*"Bash"'; then
  IS_BASH=1
  # **The command guard (lever-5 port), before the workflows and independent
  # of any written file.** An error of the class `mishandling` may carry a
  # `command_pattern`; src/commandguard.mjs warns once per session and
  # error when the command matches, and never blocks. The node start is
  # paid only when (a) a line of `.pipeline/command-guard/words.txt` (first
  # wording of each pattern) stands in the hook JSON (grep -F), or (b) the
  # booklet is missing or older than an error drawer AND some drawer holds
  # a `"command_pattern"` (node then rebuilds it). Nothing armed: a few
  # stat calls, no process. May be falsely positive, never falsely negative
  # (except two spaces in the raw text, see the module head).
  CGD="$TOOL_ROOT/src/commandguard.mjs"
  cg_needed() {
    local dir="$ROOT/.pipeline/command-guard" f sz stale=""
    if [ -f "$dir/rules.json" ]; then
      for f in "$ROOT/global/errors.jsonl" "$ROOT"/projects/*/errors.jsonl; do
        # Strictly newer = stale. bash 3.2 (macOS /bin/bash) compares mtimes in
        # whole seconds, so a drawer appended in the same second as the booklet
        # does NOT look newer; the size decides that case (sizes.txt, written by
        # the build; the drawers are append-only so a change changes the size).
        # A tie alone must not count as stale: the booklet is normally built
        # right after the drawer, and a tie-as-stale started node on every
        # command (macOS, test "prefilter: node starts only on a keyword hit").
        # A missing sizes.txt (older booklet) is stale: one node start, which
        # writes it.
        [ -f "$f" ] || continue
        if [ "$f" -nt "$dir/rules.json" ] || [ ! -f "$dir/sizes.txt" ]; then stale=1; break; fi
        sz="$(wc -c < "$f" | tr -d ' ')"
        if ! grep -qxF "$sz ${f#"$ROOT"/}" "$dir/sizes.txt"; then stale=1; break; fi
      done
      if [ -z "$stale" ]; then
        [ -s "$dir/words.txt" ] && printf '%s' "$IN" | grep -qFf "$dir/words.txt"
        return
      fi
    fi
    grep -qs '"command_pattern"' "$ROOT/global/errors.jsonl" "$ROOT"/projects/*/errors.jsonl
  }
  if [ -f "$CGD" ] && cg_needed; then
    CG_OUT="$(printf '%s' "$IN" | CHEAP_MEM_ROOT="$ROOT" capped 5 node "$CGD" bash 2>/dev/null)"
    if [ -n "$CG_OUT" ]; then
      printf '%s' "$CG_OUT"
      trace "command-guard"
      exit 0
    fi
  fi
  # **Workflows first (wf-bc B3 port), independent of any written file.**
  # `npm test` or `git rebase` write no file, so the prefilter below
  # would leave silently before a workflow's `tool_patterns` were ever
  # looked at. A workflow hit goes out at once, with its own journal
  # line (src/workflowdetect.mjs decides and books); no hit falls through
  # unchanged. The node start is paid only when some workflow drawer
  # holds a `tool_patterns` field at all — a grep, no process.
  WFD="$TOOL_ROOT/src/workflowdetect.mjs"
  if [ -f "$WFD" ] && grep -qs '"tool_patterns"' "$ROOT/global/workflows.jsonl" "$ROOT"/projects/*/workflows.jsonl; then
    WF_OUT="$(printf '%s' "$IN" | CHEAP_MEM_ROOT="$ROOT" capped 5 node "$WFD" bash 2>/dev/null)"
    if [ -n "$WF_OUT" ]; then
      printf '%s' "$WF_OUT"
      trace "workflow"
      exit 0
    fi
  fi
  STRIPPED="$(printf '%s' "$IN" | sed -E 's/[0-9]*>&[0-9-]+//g; s/&?>>?[[:space:]]*\/dev\/null//g')"
  if ! printf '%s' "$STRIPPED" | grep -q '>' \
     && ! printf '%s' "$STRIPPED" | grep -qE '(^|[^A-Za-z0-9_-])(tee|sed|cp|mv)($|[^A-Za-z0-9_-])'; then
    trace "bash-not-a-write"
    exit 0
  fi
fi
# **One node process for everything else (TB5, 2026-10-14).** Reading the
# path, the watermark and the mark, the component lookup, the pick, the
# second decision, the mark and the journal line used to be a dozen
# `node -e` snippets plus a full `node bin/mem component` — 13 node starts
# and about 1.1 s for one edit with a hit (src/beforeedit.mjs has the
# measurement). They are now plain function calls in
# bin/mem-before-edit-core.mjs; this script keeps what is shell business.
#
# The core sits next to whichever tool is about to run, else next to this
# script. The path is handed to node as the one argument it is: on Windows
# `cygpath -m` turns the MSYS form into one a Windows node can open.
CORE="$TOOL_ROOT/bin/mem-before-edit-core.mjs"
[ -f "$CORE" ] || CORE="$HOOK_DIR/mem-before-edit-core.mjs"
[ -f "$CORE" ] || { trace "no-core (TOOL_ROOT=$TOOL_ROOT HOOK_DIR=$HOOK_DIR)"; exit 0; }
command -v cygpath >/dev/null 2>&1 && CORE="$(cygpath -m "$CORE")"

# The whole run shares ONE time cap (it used to cap the search alone, at 5 s;
# the rest was plain function calls even then, and still is). Cut off, the
# search never answered: book `rebuild` and say so on the trace, as before.
printf '%s' "$IN" | CHEAP_MEM_ROOT="$ROOT" MEM_BE_START_MS="$MEM_BE_START_MS" capped 8 node "$CORE"
if [ "$?" -eq 124 ]; then
  journal_book rebuild 0 0
  trace "search-failed"
fi
exit 0
