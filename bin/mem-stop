#!/usr/bin/env bash
# mem-stop — the ONE environment-independent Stop hook.
#
# The problem this fixes: the installed Stop hook delegated to mem-reflect
# (a MODEL call), and the model-free mem-capture was not the registered
# hook. In a cloud sandbox the model call does not run, so the session
# captured NOTHING. And even where capture ran, nothing pushed it — the
# watcher only pulls inbound mail, it never pushes captures out. So an
# ephemeral environment lost the capture, and a machine without a watcher
# never synced it. Gappy.
#
# This hook makes capture model-free AND persistent, everywhere:
#
#   0. Answer     the last answer against patterns tied to a LOGGED
#      check      error in THIS memory (src/answercheck.mjs). A hit is
#                 the only thing this hook ever writes to stdout:
#                 `{"decision":"block","reason":...}`, which resumes the
#                 SAME turn instead of waiting for the next one to catch
#                 it. Patterns are this memory's own data
#                 (.mem/answer-patterns.json, see
#                 docs/answer-check-patterns.example.json) — never a
#                 built-in list, and never on suspicion: a pattern whose
#                 `error_id` is not actually logged here is dropped
#                 before it can match anything. No populated, matching
#                 patterns file means this step is a no-op.
#   0c. Closing    the open duties of THIS session, briefly (X2b,
#      report     src/closingreport.mjs): a `systemMessage`, never a block,
#                 once per session per duty; silent when there is none.
#   1. Capture   model-free (~50ms), ALWAYS, every environment / repo.
#   2. Persist   commit raw/ + push — SYNCHRONOUS, best-effort. Nothing
#                else pushes captures, so this hook does. Synchronous
#                because an ephemeral environment (cloud) is reclaimed
#                right after; a detached push would not arrive. Best-effort
#                because an offline laptop keeps the capture committed
#                locally and the next run pushes it — nothing is lost as
#                long as the disk persists. Opt out with MEM_STOP_NO_PUSH=1.
#   3. Reflect   the MODEL summary (mem-reflect) runs only when opted in
#                (MEM_REFLECT=1) — off by default so the Stop path stays
#                model-free, matching cheap-mem's whole design.
#
# Always exits 0: a Stop hook must never break the session it is attached to.

set -u

# Backslashes become slashes before a path is used as a path.
#
# On Windows every path handed to a hook is native: the memory root,
# and `$0` itself. bash then finds nothing where something is, and the
# hook exits 0 without a word — indistinguishable from "nothing to
# report". Two places per hook needed this, and five hooks carried the
# same copy. Git Bash resolves `C:/…` fine; on Linux and macOS the
# substitution changes nothing.
to_slashes() { printf '%s' "${1//\\//}"; }
[ "${MEM_HOOK_OFF:-}" = "1" ] && exit 0
[ "${MEM_CAPTURE_OFF:-}" = "1" ] && exit 0
# Never capture ourselves — the digest/worker sets this to avoid the
# snake eating its tail.
[ -n "${MEM_HEADLESS:-}" ] && exit 0

# Resolve the memory root (has .mem/config.json). CHEAP_MEM_ROOT is what
# the installer hardcodes; the probe (only $HOME/cheap-mem unless
# MEM_STOP_ROOTS says otherwise) keeps the hook usable by hand.
PROBE="${MEM_STOP_ROOTS:-$HOME/cheap-mem}"

ROOT=""
# shellcheck disable=SC2086
for k in "${CHEAP_MEM_ROOT:-}" $PROBE; do
  [ -z "$k" ] && continue
  k="$(to_slashes "$k")"
  [ -f "$k/.mem/config.json" ] && { ROOT="$k"; break; }
done
[ -z "$ROOT" ] && exit 0

# `$0` is a path from outside too: on Windows `dirname` of a
# backslash path returns `.`, so this would become the CURRENT
# directory instead of bin/.
HERE="$(cd "$(dirname "$(to_slashes "$0")")" && pwd)"

STDIN_JSON=""
if [ ! -t 0 ]; then STDIN_JSON="$(cat 2>/dev/null || true)"; fi

# Portable time cap, from the shared file: GNU `timeout`, else
# `gtimeout`, else a perl watchdog, else a Node watchdog (every step below
# needs node anyway). This hook used to carry its own copy that knew only
# the first two and otherwise ran the command UNCAPPED without a word - a
# "cap" that does not cap, on a box with no GNU tools (minimal container,
# Windows Git Bash without perl). Now the way is named, and "no cap at
# all" is said out loud (stderr here, a systemMessage at the end).
if [ -f "$HERE/_portable.sh" ]; then
  # shellcheck source=bin/_portable.sh
  . "$HERE/_portable.sh"
else
  mem_cap_kind=none
  capped() { shift; "$@"; }
fi
cap() { capped "$@"; }
case "$mem_cap_kind" in
  timeout | gtimeout) ;;
  none) echo "mem-stop: NO time cap available (no timeout, gtimeout, perl or node on PATH, or bin/_portable.sh missing) - git and checks run without a limit" >&2 ;;
  *) echo "mem-stop: time cap via $mem_cap_kind watchdog (no GNU timeout on PATH)" >&2 ;;
esac

# --- 0) Answer check (see the header) -------------------------------
# Computed FIRST and printed LAST (after capture/persist/reflect below),
# so a hit never changes whether the rest of this hook still runs. This
# is meant to be the ONLY thing this hook ever writes to stdout; every
# other step below is redirected to /dev/null.
ANSWER_JSON=""
CHECKER=""
if   [ -f "$ROOT/src/answercheck.mjs" ]; then CHECKER="$ROOT/src/answercheck.mjs"
elif [ -f "$HERE/../src/answercheck.mjs" ]; then CHECKER="$HERE/../src/answercheck.mjs"
fi
if [ -n "$CHECKER" ] && [ -n "$STDIN_JSON" ]; then
  # An ESM specifier is a URL, not a path — same trap mem-before-edit
  # already carries a note about: this script also runs under Git Bash
  # on Windows, where a bare path is `D:/a/...` and Node reads `D:` as
  # a URL SCHEME.
  CHECKER_FS="$CHECKER"
  command -v cygpath >/dev/null 2>&1 && CHECKER_FS="$(cygpath -m "$CHECKER")"
  case "$CHECKER_FS" in
    /*) CHECKER_URL="file://$CHECKER_FS" ;;
    *)  CHECKER_URL="file:///$CHECKER_FS" ;;
  esac
  ANSWER_JSON="$(printf '%s' "$STDIN_JSON" | CHEAP_MEM_ROOT="$ROOT" cap 10 node -e '
    let raw = ""; process.stdin.on("data", (d) => { raw += d; });
    process.stdin.on("end", () => {
      import(process.argv[1]).then((m) => {
        let input = null; try { input = JSON.parse(raw); } catch { return; }
        const r = m.checkStop(process.env.CHEAP_MEM_ROOT, input);
        if (r) process.stdout.write(JSON.stringify(r));
      }).catch(() => {});
    });' "$CHECKER_URL" 2>/dev/null)" || ANSWER_JSON=""
fi

# --- 0c) Closing report (X2b) ----------------------------------------
# The task-end occasion of the integration contract: which duties from
# THIS session are still open, said briefly (src/closingreport.mjs; the
# count is the one behind the day's number — this only filters). Report
# only, never block: the output is `{"systemMessage":...}`, never
# `decision:block`. And only when step 0 blocks nothing: an answer
# correction wins, and the report is then NOT used up (it comes at the
# next end of turn). Once per session per duty.
REPORT_JSON=""
if [ -z "$ANSWER_JSON" ] && [ -n "$STDIN_JSON" ]; then
  REPORTER=""
  if   [ -f "$ROOT/src/closingreport.mjs" ]; then REPORTER="$ROOT/src/closingreport.mjs"
  elif [ -f "$HERE/../src/closingreport.mjs" ]; then REPORTER="$HERE/../src/closingreport.mjs"
  fi
  if [ -n "$REPORTER" ]; then
    REPORTER_FS="$REPORTER"
    command -v cygpath >/dev/null 2>&1 && REPORTER_FS="$(cygpath -m "$REPORTER")"
    case "$REPORTER_FS" in
      /*) REPORTER_URL="file://$REPORTER_FS" ;;
      *)  REPORTER_URL="file:///$REPORTER_FS" ;;
    esac
    REPORT_JSON="$(printf '%s' "$STDIN_JSON" | CHEAP_MEM_ROOT="$ROOT" cap 10 node -e '
      let raw = ""; process.stdin.on("data", (d) => { raw += d; });
      process.stdin.on("end", () => {
        import(process.argv[1]).then((m) => {
          let input = null; try { input = JSON.parse(raw); } catch { return; }
          const r = m.stopReport(process.env.CHEAP_MEM_ROOT, input);
          if (r) process.stdout.write(JSON.stringify(r));
        }).catch(() => {});
      });' "$REPORTER_URL" 2>/dev/null)" || REPORT_JSON=""
  fi
fi

# --- 1) Capture (model-free, always) --------------------------------
CAPTURE=""
if   [ -f "$ROOT/bin/mem-capture" ]; then CAPTURE="$ROOT/bin/mem-capture"
elif [ -f "$HERE/mem-capture" ];    then CAPTURE="$HERE/mem-capture"
fi
if [ -n "$CAPTURE" ]; then
  printf '%s' "$STDIN_JSON" | CHEAP_MEM_ROOT="$ROOT" bash "$CAPTURE" >/dev/null 2>&1 || true
fi

# --- 2) Persist (commit raw/ + its record + push, best-effort) ------
#
# The capture and its RECORD belong together. The record lives at the
# root (src/archive.mjs RECORD_FILE), not under raw/, so staging only
# raw/ leaves it behind — in the sibling memory that happened in 626 of
# 627 capture commits, and the one exception was made by hand.
#
# Three quiet consequences, all measured there:
#   1. A left-behind change to a TRACKED file makes the tree dirty, and
#      the session-start hook's `pull --ff-only` aborts. The clone then
#      falls behind until somebody commits by hand.
#   2. A janitor that classifies paths by directory prefix does not
#      recognise a root-level file as memory content and reports it as
#      foreign code, round after round.
#   3. With the archive moved off the repo (MEM_RAW_ARCHIVE), raw/ is
#      empty, the condition never fires, and the only thing that would
#      ever have reached git stays behind.
#
# The record is the part that STAYS — the archive is allowed to move.
# Leaving it out means throwing away the receipt and keeping the box.
#
# As a PATHSPEC only if the file exists: git aborts on a pathspec that
# matches nothing and then stages NOTHING AT ALL — not even the
# captures. A memory that has never captured has no record, and that is
# not an edge case, it is every memory's first day.
RECORD="raw-record.jsonl"
LEGACY_RECORD="raw-nachweis.jsonl"
RECORD_PATHS=""
[ -f "$ROOT/$RECORD" ] && RECORD_PATHS="$RECORD"
[ -f "$ROOT/$LEGACY_RECORD" ] && RECORD_PATHS="$RECORD_PATHS $LEGACY_RECORD"

if [ "${MEM_STOP_NO_PUSH:-}" != "1" ] && [ -d "$ROOT/.git" ]; then
  # shellcheck disable=SC2086
  if [ -n "$(git -C "$ROOT" status --porcelain raw/ $RECORD_PATHS 2>/dev/null)" ]; then
    # Bring the remote in first (untracked captures never block a
    # fast-forward), then stage ONLY raw/ and the record — never
    # `git add -A`, which would drag local pipeline state in.
    cap 30 git -C "$ROOT" pull --ff-only -q >/dev/null 2>&1 || true
    # Two sessions ending at once fight over .git/index.lock, and git
    # simply fails. Measured: of eight concurrent capture-commits, one
    # got through. Every loser swallowed its error here and the hook
    # still reported success — so in a container that gets reclaimed,
    # that capture was gone. Waiting a moment costs nothing and turns
    # the collision into a queue.
    for attempt in 1 2 3 4 5; do
      # shellcheck disable=SC2086
      git -C "$ROOT" add raw/ $RECORD_PATHS >/dev/null 2>&1 && break
      sleep 1
    done
    if git -C "$ROOT" commit -q -m "capture: $(date -u +%Y-%m-%dT%H-%M-%SZ)" >/dev/null 2>&1; then
      if ! ( cap 30 git -C "$ROOT" push -q origin HEAD:main ) >/dev/null 2>&1; then
        # Remote moved ahead — rebase once and retry.
        #
        # **--autostash, or this trap never surfaces (L12, mirrored from
        # lucky-mem's error entry 1968v6itl823, 2026-09-27).** The capture and
        # its record are already committed above, so THEY do not block
        # this. But anything else tracked and left unstaged — a stray
        # edit, a pipeline file, a half-finished change from earlier in
        # the session — makes `git rebase` refuse outright with "cannot
        # rebase: You have unstaged changes", before it looks at a single
        # commit. That refusal is swallowed by `|| true`, so the hook
        # still exits 0, and the push after it fails too, silently, on
        # every run from then on: the capture commit stacks up locally
        # forever and nothing says why. `--autostash` sets the unrelated
        # mess aside before the rebase and reapplies it afterward; the
        # capture commit itself is unaffected either way. Fail-safe: if
        # the reapply fails, git leaves the stash in place and says so —
        # nothing is lost.
        cap 30 git -C "$ROOT" pull --rebase --autostash -q >/dev/null 2>&1 || true
        cap 30 git -C "$ROOT" push -q origin HEAD:main >/dev/null 2>&1 || true
      fi
    fi
  fi
fi

# --- 3) Reflect (model, opt-in only) --------------------------------
if [ "${MEM_REFLECT:-}" = "1" ]; then
  REFLECTOR="$ROOT/bin/mem-reflect"
  [ -f "$REFLECTOR" ] || REFLECTOR="$HERE/mem-reflect"
  if [ -f "$REFLECTOR" ]; then
    printf '%s' "$STDIN_JSON" | CHEAP_MEM_ROOT="$ROOT" bash "$REFLECTOR" >/dev/null 2>&1 || true
  fi
fi

# --- 0b) Emit the answer-check result (see step 0 above) ------------
# The only stdout this hook ever produces: the answer check's block,
# or — when there is none — the closing report's `systemMessage`.
[ -n "$ANSWER_JSON" ] && printf '%s\n' "$ANSWER_JSON"
# The closing report (0c) only when no answer correction went out.
[ -z "$ANSWER_JSON" ] && [ -n "$REPORT_JSON" ] && printf '%s\n' "$REPORT_JSON"
# No cap at all is never silent: when nothing else went to stdout, the
# session is told (a systemMessage, never a block).
if [ "$mem_cap_kind" = none ] && [ -z "$ANSWER_JSON" ] && [ -z "$REPORT_JSON" ]; then
  printf '%s\n' '{"systemMessage":"cheap-mem Stop hook: no time cap available (no timeout, gtimeout, perl or node) - git steps ran without a limit"}'
fi

exit 0
